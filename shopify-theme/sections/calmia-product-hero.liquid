    padding: 11px 13px;
  }
  .calmia-delivery__icon { color: var(--cal-green); display: grid; place-items: center; }
  .calmia-delivery__body { min-width: 0; }
  .calmia-delivery p { margin: 0; font-size: 13.5px; color: #24593c; min-width: 0; }
  .calmia-delivery b { font-weight: 700; }
  .calmia-delivery__cutoff { margin-bottom: 2px !important; }
  .calmia-delivery__cutoff b { font-variant-numeric: tabular-nums; }
  .calmia-delivery__eta { opacity: 0.85; font-size: 12.5px !important; }

  .calmia-quote { display: grid; grid-template-columns: auto auto 1fr; gap: 10px; align-items: center; margin: 16px 0 0; padding-top: 16px; border-top: 1px solid var(--cal-line); }
  .calmia-quote__avatar { width: 42px; height: 42px; border-radius: 50%; object-fit: cover; }
  .calmia-quote__text { font-size: 13.5px; color: var(--cal-ink-2); line-height: 1.45; margin: 0; }
  .calmia-quote__text span { color: var(--cal-ink-3); }

  .calmia-trustline {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: var(--cal-ink-3);
    font-size: 14px;
    margin: 16px 0 0;
    padding-top: 14px;
    border-top: 1px solid var(--cal-line);
    text-align: center;
  }
  .calmia-pay { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; margin: 14px 0 0; }
  .calmia-pay__i {
    border: 1px solid var(--cal-line);
    border-radius: 10px;
    padding: 6px 10px;
    background: #fff;
    display: grid;
    place-items: center;
    height: 40px;
  }
  .calmia-pay__i svg { height: 22px; width: auto; }

  .calmia-acc { margin: 26px 0 0; }
  .calmia-acc__item { border-bottom: 1px solid var(--cal-line); }
  .calmia-acc__item summary {
    list-style: none;
    display: grid;
    grid-template-columns: 48px 1fr 24px;
    gap: 14px;
    align-items: center;
    padding: 18px 0;
    cursor: pointer;
  }
  .calmia-acc__item summary::-webkit-details-marker { display: none; }
  .calmia-acc__icon {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--cal-pink-4);
    color: var(--cal-pink);
    display: grid;
    place-items: center;
  }
  .calmia-acc__title { font-size: clamp(16px, 4.2vw, 19px); font-weight: 600; }
  .calmia-acc__chev { color: var(--cal-ink-3); transition: transform 0.2s ease; }
  .calmia-acc__item[open] .calmia-acc__chev { transform: rotate(180deg); }
  .calmia-acc__body { padding: 0 0 18px 62px; color: var(--cal-ink-2); font-size: 15px; }

  .calmia-social {
    display: flex;
    align-items: center;
    gap: 14px;
    background: rgba(255, 255, 255, 0.55);
    border: 1px solid var(--cal-pink-3);
    border-radius: 18px;
    padding: 14px 16px;
    margin: 24px 0 0;
  }
  .calmia-social__avatars { display: flex; }
  .calmia-social__avatars img {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid #fff;
    margin-left: -12px;
  }
  .calmia-social__avatars img:first-child { margin-left: 0; }
  .calmia-social p { font-size: 14.5px; color: var(--cal-ink-2); margin: 0; }

  @media (min-width: 990px) {
    .calmia-hero { padding: 26px 0 64px; }
    .calmia-hero__grid { grid-template-columns: 1.05fr 1fr; gap: 46px; align-items: start; }
    .calmia-gallery { position: sticky; top: 24px; }
    .calmia-offer { padding: 24px; }
    .calmia-gift__img { width: 72px; height: 72px; }
  }
</style>

{%- if section.settings.show_schema -%}
