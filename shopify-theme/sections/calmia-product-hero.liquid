{%- comment -%}
  Calmia · Hero de producto (galería + bloque de compra)
  Réplica de la estructura de la landing de referencia, adaptada a ReliefPath™.
{%- endcomment -%}

{% render 'calmia-base' %}

{%- liquid
  assign p = product
  if section.settings.product != blank
    assign p = section.settings.product
  endif
-%}

{%- if p == blank -%}
  <div class="cal cal-sec"><div class="cal-wrap"><p style="text-align:center">Selecciona un producto en los ajustes de la sección.</p></div></div>
{%- else -%}

{%- liquid
  assign cv = p.selected_or_first_available_variant
  assign has_compare = false
  if cv.compare_at_price > cv.price
    assign has_compare = true
  endif
  assign pct = 0
  assign save_amount = 0
  if has_compare
    assign save_amount = cv.compare_at_price | minus: cv.price
    assign pct = save_amount | times: 100.0 | divided_by: cv.compare_at_price | round
  endif

  assign rating = section.settings.rating
  assign rating_count = section.settings.rating_count
  if section.settings.rating_from_metafield and p.metafields.reviews.rating.value != blank
    assign rating = p.metafields.reviews.rating.value.rating | times: 1.0
    assign rating_count = p.metafields.reviews.rating_count.value
  endif
  assign rating_display = rating | round: 1

  assign pack_count = 0
  assign first_pack_id = ''
  assign first_qty = 1
  assign default_pack_id = ''
  assign default_qty = 1
  for block in section.blocks
    if block.type == 'pack'
      assign pack_count = pack_count | plus: 1
      if first_pack_id == ''
        assign first_pack_id = block.id
        assign first_qty = block.settings.quantity | default: 1
      endif
      if block.settings.preselected and default_pack_id == ''
        assign default_pack_id = block.id
        assign default_qty = block.settings.quantity | default: 1
      endif
    endif
  endfor
  if default_pack_id == ''
    assign default_pack_id = first_pack_id
    assign default_qty = first_qty
  endif

  assign default_disc = 0
  for block in section.blocks
    if block.type == 'pack' and block.id == default_pack_id
      assign default_disc = block.settings.discount | default: 0
    endif
  endfor

  assign base_unit = cv.price
  if has_compare
    assign base_unit = cv.compare_at_price
  endif
  assign dmult = 100 | minus: default_disc
  assign default_total = cv.price | times: default_qty | times: dmult | divided_by: 100
  assign default_cross = base_unit | times: default_qty
  assign default_save = default_cross | minus: default_total

  assign cta_price = cv.price
  assign save_display = save_amount
  if pack_count > 0
    assign cta_price = default_total
    assign save_display = default_save
  endif

  assign gal_count = 0
  assign first_src = ''
  assign first_alt = ''
  if section.settings.gallery_source == 'blocks'
    for block in section.blocks
      if block.type == 'gallery' and block.settings.image != blank
        assign gal_count = gal_count | plus: 1
        if first_src == ''
          assign first_src = block.settings.image | image_url: width: 1100
          assign first_alt = block.settings.image.alt | default: p.title
        endif
      endif
    endfor
  endif
  assign use_blocks = false
  if gal_count > 0
    assign use_blocks = true
  else
    assign gal_count = p.media.size
    if p.featured_media
      assign first_src = p.featured_media | image_url: width: 1100
      assign first_alt = p.featured_media.alt | default: p.title
    endif
  endif

  assign months = 'enero,febrero,marzo,abril,mayo,junio,julio,agosto,septiembre,octubre,noviembre,diciembre' | split: ','
  assign now_ts = 'now' | date: '%s' | times: 1
  assign min_ts = section.settings.delivery_min | times: 86400 | plus: now_ts
  assign max_ts = section.settings.delivery_max | times: 86400 | plus: now_ts
  assign min_day = min_ts | date: '%-d'
  assign max_day = max_ts | date: '%-d'
  assign min_mi = min_ts | date: '%-m' | minus: 1
  assign max_mi = max_ts | date: '%-m' | minus: 1
  assign min_month = months[min_mi]
  assign max_month = months[max_mi]
  if min_month == max_month
    assign delivery_range = min_day | append: ' y el ' | append: max_day | append: ' de ' | append: max_month
  else
    assign delivery_range = min_day | append: ' de ' | append: min_month | append: ' y el ' | append: max_day | append: ' de ' | append: max_month
  endif

  assign bump = section.settings.bump_product
  assign bump_variant = bump.selected_or_first_available_variant

  assign tz = 'now' | date: '%z'
  assign stock_qty = 0
  assign stock_tracked = false
  if cv.inventory_management != blank
    assign stock_tracked = true
    assign stock_qty = cv.inventory_quantity
  endif
  assign show_stock = false
  if section.settings.show_stock and stock_tracked and stock_qty > 0 and stock_qty <= section.settings.stock_threshold
    assign show_stock = true
  endif
  assign stock_pct = stock_qty | times: 100 | divided_by: section.settings.stock_threshold
  if stock_pct < 8
    assign stock_pct = 8
  endif
-%}

<div class="cal calmia-hero" id="calmia-hero-{{ section.id }}">
  <div class="cal-wrap">

    {%- if section.settings.badge_left != blank or section.settings.show_discount_badge -%}
      <div class="calmia-hero__badges">
        {%- if section.settings.badge_left != blank -%}
          <span class="cal-pill">{{ section.settings.badge_left }}</span>
        {%- endif -%}
        {%- if section.settings.show_discount_badge and pct > 0 -%}
          <span class="cal-pill cal-pill--pink">&minus;{{ pct }}%</span>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="calmia-hero__grid">

      {%- comment -%} ---------------- Galería ---------------- {%- endcomment -%}
      <div class="calmia-gallery" data-calmia-gallery>
        <div class="calmia-gallery__main">
          {%- if first_src != blank -%}
            <img
              src="{{ first_src }}"
              alt="{{ first_alt | escape }}"
              loading="eager"
              fetchpriority="high"
              data-calmia-main
            >
          {%- endif -%}
          {%- if gal_count > 1 -%}
            <button type="button" class="calmia-gallery__nav calmia-gallery__nav--prev" data-calmia-prev aria-label="Imagen anterior">{% render 'calmia-icon', icon: 'chevron', size: 22 %}</button>
            <button type="button" class="calmia-gallery__nav calmia-gallery__nav--next" data-calmia-next aria-label="Imagen siguiente">{% render 'calmia-icon', icon: 'chevron', size: 22 %}</button>
          {%- endif -%}
        </div>

        {%- if gal_count > 1 -%}
          <div class="calmia-gallery__thumbs" role="list">
            {%- if use_blocks -%}
              {%- assign gi = 0 -%}
              {%- for block in section.blocks -%}
                {%- if block.type == 'gallery' and block.settings.image != blank -%}
                  <button
                    type="button"
                    class="calmia-gallery__thumb{% if gi == 0 %} is-active{% endif %}"
                    data-calmia-thumb
                    data-index="{{ gi }}"
                    data-src="{{ block.settings.image | image_url: width: 1100 }}"
                    aria-label="Ver imagen {{ gi | plus: 1 }}"
                    {{ block.shopify_attributes }}
                  >
                    <img src="{{ block.settings.image | image_url: width: 240 }}" alt="{{ block.settings.image.alt | escape }}" width="240" height="240" loading="lazy">
                  </button>
                  {%- assign gi = gi | plus: 1 -%}
                {%- endif -%}
              {%- endfor -%}
            {%- else -%}
              {%- for m in p.media limit: 10 -%}
                <button
                  type="button"
                  class="calmia-gallery__thumb{% if forloop.first %} is-active{% endif %}"
                  data-calmia-thumb
                  data-index="{{ forloop.index0 }}"
                  data-src="{{ m | image_url: width: 1100 }}"
                  aria-label="Ver imagen {{ forloop.index }}"
                >
                  <img src="{{ m | image_url: width: 240 }}" alt="{{ m.alt | escape }}" width="240" height="240" loading="lazy">
                </button>
              {%- endfor -%}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} ---------------- Bloque de compra ---------------- {%- endcomment -%}
      <div class="calmia-buy">

        {%- if section.settings.eyebrow != blank -%}
          <p class="cal-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}

        <h1 class="cal-h1">
          {{ section.settings.heading }}
          {%- if section.settings.heading_italic != blank -%}<em>{{ section.settings.heading_italic }}</em>{%- endif -%}
        </h1>

        {%- if section.settings.subheading != blank -%}
          <p class="cal-lead">{{ section.settings.subheading }}</p>
        {%- endif -%}

        {%- if section.settings.show_rating -%}
          <div class="calmia-rating">
            {% render 'calmia-rating', rating: rating, size: 21 %}
            <strong>{{ rating_display }}</strong>
            <span class="calmia-rating__dot">·</span>
            <span>{{ rating_count }} reseñas</span>
          </div>
        {%- endif -%}

        <div class="calmia-price">
          {%- if has_compare -%}
            <s class="calmia-price__was" data-calmia-compare>{{ cv.compare_at_price | money }}</s>
          {%- endif -%}
          <span class="calmia-price__now" data-calmia-price>{{ cv.price | money }}</span>
          {%- if pct > 0 -%}
            <span class="calmia-price__off" data-calmia-pct>&minus;{{ pct }}%</span>
          {%- endif -%}
        </div>

        {%- if has_compare and section.settings.show_savings -%}
          <div class="calmia-save">
            {{ section.settings.savings_label }} <b data-calmia-save>{{ save_display | money }}</b> {{ section.settings.savings_suffix }}
          </div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="calmia-usps">
            {%- for block in section.blocks -%}
              {%- if block.type == 'usp' -%}
                <li class="cal-check" {{ block.shopify_attributes }}>
                  <i>{% render 'calmia-icon', icon: 'check', size: 15 %}</i>
                  <span>{{ block.settings.text }}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- comment -%} ---------------- Tarjeta de checkout ---------------- {%- endcomment -%}
        <div class="calmia-offer">

          {%- if section.settings.stock_label != blank -%}
            <span class="calmia-offer__stock"><span class="calmia-offer__dot"></span>{{ section.settings.stock_label }}</span>
          {%- endif -%}

          {%- if pack_count > 0 -%}
            <div class="calmia-packs" data-calmia-packs>
              {%- if section.settings.packs_title != blank -%}
                <p class="calmia-packs__title">{{ section.settings.packs_title }}</p>
              {%- endif -%}

              {%- for block in section.blocks -%}
                {%- if block.type == 'pack' -%}
                  {%- liquid
                    assign q = block.settings.quantity | default: 1
                    assign d = block.settings.discount | default: 0
                    assign mult = 100 | minus: d
                    assign p_total = cv.price | times: q | times: mult | divided_by: 100
                    assign p_unit = p_total | divided_by: q
                    assign p_cross = base_unit | times: q
                    assign p_save = p_cross | minus: p_total
                    assign is_on = false
                    if block.id == default_pack_id
                      assign is_on = true
                    endif
                  -%}
                  <label
                    class="calmia-pack{% if is_on %} is-active{% endif %}{% if block.settings.highlight %} is-featured{% endif %}"
                    {{ block.shopify_attributes }}
                  >
                    <input
                      type="radio"
                      name="calmia-pack-{{ section.id }}"
                      value="{{ block.id }}"
                      data-calmia-pack="{{ block.id }}"
                      data-qty="{{ q }}"
                      data-code="{{ block.settings.discount_code | escape }}"
                      {% if is_on %}checked{% endif %}
                    >
                    <span class="calmia-pack__mark" aria-hidden="true"></span>
                    <span class="calmia-pack__body">
                      <span class="calmia-pack__name">{{ block.settings.name }}</span>
                      {%- if block.settings.note != blank -%}
                        <span class="calmia-pack__note">{{ block.settings.note }}</span>
                      {%- endif -%}
                      {%- if q > 1 -%}
                        <span class="calmia-pack__unit"><b data-calmia-pack-unit>{{ p_unit | money }}</b> {{ section.settings.per_unit_label }}</span>
                      {%- endif -%}
                    </span>
                    <span class="calmia-pack__prices">
                      <b data-calmia-pack-total>{{ p_total | money }}</b>
                      {%- if p_cross > p_total -%}
                        <s data-calmia-pack-cross>{{ p_cross | money }}</s>
                      {%- endif -%}
                    </span>
                    {%- if block.settings.badge != blank -%}
                      <span class="calmia-pack__badge">{{ block.settings.badge }}</span>
                    {%- endif -%}
                    {%- if p_save > 0 -%}
                      <span class="calmia-pack__save">{{ section.settings.pack_save_label }} <b data-calmia-pack-save>{{ p_save | money }}</b></span>
                    {%- endif -%}
                  </label>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}

          {%- if section.settings.show_stock and stock_tracked -%}
            <div class="calmia-stock" data-calmia-stock{% unless show_stock %} hidden{% endunless %}>
              <p class="calmia-stock__text">
                {{ section.settings.stock_prefix }}
                <b data-calmia-stock-qty>{{ stock_qty }}</b>
                {{ section.settings.stock_suffix }}
                <span data-calmia-stock-variant>{{ cv.title }}</span>
              </p>
              <span class="calmia-stock__bar"><i data-calmia-stock-bar style="width: {{ stock_pct }}%"></i></span>
            </div>
          {%- endif -%}

          {%- if section.settings.gift_title != blank -%}
            <div class="calmia-gift">
              <div class="calmia-gift__row">
                {%- if section.settings.gift_image != blank -%}
                  <img class="calmia-gift__img" src="{{ section.settings.gift_image | image_url: width: 180 }}" alt="{{ section.settings.gift_title | escape }}" width="180" height="180" loading="lazy">
                {%- endif -%}
                <div class="calmia-gift__body">
                  <span class="calmia-gift__qty">1X</span>
                  <p class="calmia-gift__title">{{ section.settings.gift_title }}</p>
                </div>
                <div class="calmia-gift__price">
                  <span class="calmia-gift__free">GRATIS</span>
                  {%- if section.settings.gift_value != blank -%}
                    <s>{{ section.settings.gift_value }}</s>
                  {%- endif -%}
                </div>
              </div>
              {%- if section.settings.gift_note != blank -%}
                <p class="calmia-gift__note">🎁 {{ section.settings.gift_note }}</p>
              {%- endif -%}
            </div>
            <div class="calmia-plus" aria-hidden="true"><span>+</span></div>
          {%- endif -%}

          <form method="post" action="{{ routes.cart_add_url }}" class="calmia-form" data-calmia-form enctype="multipart/form-data">
            <input type="hidden" name="form_type" value="product">
            <input type="hidden" name="utf8" value="✓">
            <input type="hidden" name="quantity" value="{{ default_qty }}" data-calmia-qty>
            <input type="hidden" name="id" value="{{ cv.id }}" data-calmia-varid>
            {%- if section.settings.cta_target == 'checkout' -%}
              <input type="hidden" name="return_to" value="/checkout" data-calmia-return data-base="/checkout">
            {%- elsif section.settings.cta_target == 'cart' -%}
              <input type="hidden" name="return_to" value="/cart" data-calmia-return data-base="/cart">
            {%- endif -%}

            {%- unless p.has_only_default_variant -%}
              {%- for option in p.options_with_values -%}
                <div class="calmia-options">
                  <span class="calmia-options__label">{{ option.name }}: <b data-calmia-optlabel="{{ forloop.index0 }}">{{ option.selected_value }}</b></span>
                  <div class="calmia-options__list">
                    {%- for value in option.values -%}
                      <label class="calmia-opt{% if option.selected_value == value %} is-active{% endif %}">
                        <input
                          type="radio"
                          name="calmia-option-{{ section.id }}-{{ forloop.parentloop.index0 }}"
                          value="{{ value | escape }}"
                          data-calmia-option="{{ forloop.parentloop.index0 }}"
                          {% if option.selected_value == value %}checked{% endif %}
                        >
                        <span>{{ value }}</span>
                      </label>
                    {%- endfor -%}
                  </div>
                </div>
              {%- endfor -%}
            {%- endunless -%}

            {%- if bump != blank and bump_variant.available -%}
              <label class="calmia-bump">
                <input type="checkbox" data-calmia-bump value="{{ bump_variant.id }}">
                <span class="calmia-bump__box" aria-hidden="true">{% render 'calmia-icon', icon: 'check', size: 13 %}</span>
                <span class="calmia-bump__body">
                  <b>{{ section.settings.bump_title | default: bump.title }}</b>
                  {%- if section.settings.bump_text != blank -%}
                    <span>{{ section.settings.bump_text }}</span>
                  {%- endif -%}
                </span>
                <span class="calmia-bump__price">+{{ bump_variant.price | money }}</span>
              </label>
            {%- endif -%}

            <button type="submit" name="add" class="cal-btn calmia-cta" data-calmia-submit>
              {% render 'calmia-icon', icon: 'bag', size: 26 %}
              <span data-calmia-ctatext>{{ section.settings.cta_text }}</span>
              <span class="cal-btn__sep">—</span>
              <span data-calmia-ctaprice>{{ cta_price | money }}</span>
            </button>
          </form>

          {%- if section.settings.show_delivery -%}
            <div class="calmia-delivery">
              <span class="calmia-delivery__icon">{% render 'calmia-icon', icon: 'truck', size: 18 %}</span>
              <div class="calmia-delivery__body">
                {%- if section.settings.show_cutoff -%}
                  <p
                    class="calmia-delivery__cutoff"
                    data-calmia-cutoff
                    data-tz="{{ tz }}"
                    data-hour="{{ section.settings.cutoff_hour }}"
                    data-weekdays="{{ section.settings.cutoff_weekdays }}"
                    hidden
                  >
                    {{ section.settings.cutoff_prefix }}
                    <b data-calmia-cutoff-time>—</b>
                    <span data-calmia-cutoff-when></span>
                  </p>
                {%- endif -%}
                <p class="calmia-delivery__eta">{{ section.settings.delivery_text }} <b>{{ delivery_range }}</b></p>
              </div>
            </div>
          {%- endif -%}

          {%- if section.settings.quote != blank -%}
            <div class="calmia-quote">
              {%- if section.settings.quote_avatar != blank -%}
                <img class="calmia-quote__avatar" src="{{ section.settings.quote_avatar | image_url: width: 120 }}" alt="" width="120" height="120" loading="lazy">
              {%- endif -%}
              {% render 'calmia-rating', rating: 5, size: 13, small: true %}
              <p class="calmia-quote__text">“{{ section.settings.quote }}”<span> — {{ section.settings.quote_author }}</span></p>
            </div>
          {%- endif -%}

          {%- if section.settings.trust_line != blank -%}
            <p class="calmia-trustline">{% render 'calmia-icon', icon: 'shield', size: 16 %} {{ section.settings.trust_line }}</p>
          {%- endif -%}

          {%- if section.settings.show_payment_icons -%}
            <div class="calmia-pay">
              {%- for type in shop.enabled_payment_types limit: 8 -%}
                <span class="calmia-pay__i">{{ type | payment_type_svg_tag: class: 'calmia-pay__svg' }}</span>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>

        {%- comment -%} ---------------- Acordeones ---------------- {%- endcomment -%}
        {%- assign acc_count = 0 -%}
        {%- for block in section.blocks -%}{%- if block.type == 'accordion' -%}{%- assign acc_count = acc_count | plus: 1 -%}{%- endif -%}{%- endfor -%}
        {%- if acc_count > 0 -%}
          <div class="calmia-acc">
            {%- for block in section.blocks -%}
              {%- if block.type == 'accordion' -%}
                <details class="calmia-acc__item" {{ block.shopify_attributes }}>
                  <summary>
                    <span class="calmia-acc__icon">{% render 'calmia-icon', icon: block.settings.icon, size: 20 %}</span>
                    <span class="calmia-acc__title">{{ block.settings.title }}</span>
                    <span class="calmia-acc__chev">{% render 'calmia-icon', icon: 'chevron', size: 20 %}</span>
                  </summary>
                  <div class="calmia-acc__body">{{ block.settings.content }}</div>
                </details>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if section.settings.social_text != blank -%}
          <div class="calmia-social">
            <div class="calmia-social__avatars">
              {%- for i in (1..4) -%}
                {%- assign key = 'avatar_' | append: i -%}
                {%- assign img = section.settings[key] -%}
                {%- if img != blank -%}
                  <img src="{{ img | image_url: width: 120 }}" alt="" width="120" height="120" loading="lazy">
                {%- endif -%}
              {%- endfor -%}
            </div>
            <p>{{ section.settings.social_text }}</p>
          </div>
        {%- endif -%}

      </div>
    </div>
  </div>
</div>

<script type="application/json" data-calmia-variants="{{ section.id }}">
  {
    "variants": [
      {%- for v in p.variants -%}
        {
          "id": {{ v.id }},
          "available": {{ v.available }},
          "options": {{ v.options | json }},
          "title": {{ v.title | json }},
          "qty": {%- if v.inventory_management != blank -%}{{ v.inventory_quantity }}{%- else -%}null{%- endif -%},
          "price": {{ v.price | money | json }},
          "compare": {{ v.compare_at_price | money | json }},
          "save": {%- if v.compare_at_price > v.price -%}{{ v.compare_at_price | minus: v.price | money | json }}{%- else -%}""{%- endif -%},
          "pct": {%- if v.compare_at_price > v.price -%}{{ v.compare_at_price | minus: v.price | times: 100.0 | divided_by: v.compare_at_price | round }}{%- else -%}0{%- endif -%},
          "packs": {
            {%- assign pk_i = 0 -%}
            {%- for b in section.blocks -%}
              {%- if b.type == 'pack' -%}
                {%- liquid
                  assign vq = b.settings.quantity | default: 1
                  assign vd = b.settings.discount | default: 0
                  assign vmult = 100 | minus: vd
                  assign vtotal = v.price | times: vq | times: vmult | divided_by: 100
                  assign vunit = vtotal | divided_by: vq
                  assign vbase = v.price
                  if v.compare_at_price > v.price
                    assign vbase = v.compare_at_price
                  endif
                  assign vcross = vbase | times: vq
                  assign vsave = vcross | minus: vtotal
                -%}
                {%- if pk_i > 0 -%},{%- endif -%}
                {%- assign pk_i = pk_i | plus: 1 -%}
                {{ b.id | json }}: {
                  "qty": {{ vq }},
                  "total": {{ vtotal | money | json }},
                  "unit": {{ vunit | money | json }},
                  "cross": {{ vcross | money | json }},
                  "save": {{ vsave | money | json }}
                }
              {%- endif -%}
            {%- endfor -%}
          },
          "image": {%- if v.image -%}{{ v.image | image_url: width: 1100 | json }}{%- else -%}""{%- endif -%}
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ],
    "soldOut": {{ section.settings.soldout_text | json }}
  }
</script>

<style>
  #calmia-hero-{{ section.id }} { background: linear-gradient(180deg, {{ section.settings.bg_top }} 0%, {{ section.settings.bg_bottom }} 100%); }
</style>

<script>
  (function () {
    var root = document.getElementById('calmia-hero-{{ section.id }}');
    if (!root) return;
    var dataEl = document.querySelector('[data-calmia-variants="{{ section.id }}"]');
    var data = {};
    try { data = JSON.parse(dataEl.textContent); } catch (e) { return; }

    /* ---- Galería ---- */
    var main = root.querySelector('[data-calmia-main]');
    var thumbs = Array.prototype.slice.call(root.querySelectorAll('[data-calmia-thumb]'));
    var idx = 0;
    function show(i) {
      if (!thumbs.length) return;
      idx = (i + thumbs.length) % thumbs.length;
      var t = thumbs[idx];
      if (main) main.src = t.getAttribute('data-src');
      thumbs.forEach(function (el) { el.classList.remove('is-active'); });
      t.classList.add('is-active');
      t.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'smooth' });
    }
    thumbs.forEach(function (t, i) { t.addEventListener('click', function () { show(i); }); });
    var prev = root.querySelector('[data-calmia-prev]');
    var next = root.querySelector('[data-calmia-next]');
    if (prev) prev.addEventListener('click', function () { show(idx - 1); });
    if (next) next.addEventListener('click', function () { show(idx + 1); });

    /* ---- Variantes ---- */
    var radios = Array.prototype.slice.call(root.querySelectorAll('[data-calmia-option]'));
    var idField = root.querySelector('[data-calmia-varid]');
    var priceEl = root.querySelector('[data-calmia-price]');
    var compareEl = root.querySelector('[data-calmia-compare]');
    var pctEl = root.querySelector('[data-calmia-pct]');
    var saveEl = root.querySelector('[data-calmia-save]');
    var ctaPrice = root.querySelector('[data-calmia-ctaprice]');
    var ctaText = root.querySelector('[data-calmia-ctatext]');
    var submit = root.querySelector('[data-calmia-submit]');

    function selected() {
      var picked = [];
      radios.forEach(function (r) { if (r.checked) picked[parseInt(r.getAttribute('data-calmia-option'), 10)] = r.value; });
      return picked;
    }

    function update() {
      var picked = selected();
      if (!picked.length) return;
      var match = null;
      data.variants.forEach(function (v) {
        var ok = true;
        picked.forEach(function (val, i) { if (val && v.options[i] !== val) ok = false; });
        if (ok && !match) match = v;
      });
      if (!match) return;

      if (idField) idField.value = match.id;
      if (priceEl) priceEl.textContent = match.price;
      if (ctaPrice) ctaPrice.textContent = match.price;
      if (compareEl) { compareEl.textContent = match.compare; compareEl.style.display = match.compare ? '' : 'none'; }
      if (pctEl) { pctEl.innerHTML = '&minus;' + match.pct + '%'; pctEl.style.display = match.pct ? '' : 'none'; }
      if (saveEl) saveEl.textContent = match.save;
      if (submit) {
        submit.disabled = !match.available;
        if (ctaText && !match.available) ctaText.textContent = data.soldOut;
      }
      if (match.image && main) main.src = match.image;

      root.querySelectorAll('[data-calmia-optlabel]').forEach(function (el) {
        var i = parseInt(el.getAttribute('data-calmia-optlabel'), 10);
        if (picked[i]) el.textContent = picked[i];
      });

      var url = new URL(window.location.href);
      url.searchParams.set('variant', match.id);
      window.history.replaceState({}, '', url.toString());

      document.querySelectorAll('[data-calmia-sticky-id]').forEach(function (el) { el.value = match.id; });
      document.querySelectorAll('[data-calmia-sticky-price]').forEach(function (el) { el.textContent = match.price; });

      currentVariant = match;
      paintPacks();
      applyPack();
      paintStock();
    }

    radios.forEach(function (r) {
      r.addEventListener('change', function () {
        root.querySelectorAll('.calmia-opt').forEach(function (l) { l.classList.remove('is-active'); });
        r.closest('.calmia-opt').classList.add('is-active');
        update();
      });
    });

    /* ---- Packs ---- */
    var packRadios = Array.prototype.slice.call(root.querySelectorAll('[data-calmia-pack]'));
    var qtyField = root.querySelector('[data-calmia-qty]');
    var returnField = root.querySelector('[data-calmia-return]');
    var currentVariant = null;

    function checkoutPath(field, code) {
      var base = field.getAttribute('data-base') || '/checkout';
      if (!code) return base;
      return '/discount/' + encodeURIComponent(code) + '?redirect=' + encodeURIComponent(base);
    }

    function packData(id) {
      if (!currentVariant || !currentVariant.packs) return null;
      return currentVariant.packs[id] || null;
    }

    /* Reescribe los precios de cada pack cuando cambia la variante */
    function paintPacks() {
      packRadios.forEach(function (r) {
        var d = packData(r.getAttribute('data-calmia-pack'));
        if (!d) return;
        var box = r.closest('.calmia-pack');
        var total = box.querySelector('[data-calmia-pack-total]');
        var unit = box.querySelector('[data-calmia-pack-unit]');
        var cross = box.querySelector('[data-calmia-pack-cross]');
        var save = box.querySelector('[data-calmia-pack-save]');
        if (total) total.textContent = d.total;
        if (unit) unit.textContent = d.unit;
        if (cross) cross.textContent = d.cross;
        if (save) save.textContent = d.save;
      });
    }

    /* Aplica el pack elegido: cantidad, precio del botón y ahorro */
    function applyPack() {
      if (!packRadios.length) return;
      var checked = root.querySelector('[data-calmia-pack]:checked') || packRadios[0];
      checked.checked = true;

      packRadios.forEach(function (r) { r.closest('.calmia-pack').classList.remove('is-active'); });
      checked.closest('.calmia-pack').classList.add('is-active');

      var qty = parseInt(checked.getAttribute('data-qty'), 10) || 1;
      var code = checked.getAttribute('data-code') || '';

      if (qtyField) qtyField.value = qty;
      if (returnField) returnField.value = checkoutPath(returnField, code);

      document.querySelectorAll('[data-calmia-sticky-qty]').forEach(function (el) { el.value = qty; });
      document.querySelectorAll('[data-calmia-sticky-return]').forEach(function (el) { el.value = checkoutPath(el, code); });

      var d = packData(checked.getAttribute('data-calmia-pack'));
      if (!d) return;
      if (ctaPrice) ctaPrice.textContent = d.total;
      if (saveEl) saveEl.textContent = d.save;
      document.querySelectorAll('[data-calmia-sticky-price]').forEach(function (el) { el.textContent = d.total; });
    }

    packRadios.forEach(function (r) { r.addEventListener('change', applyPack); });

    /* ---- Order bump ----
       El formulario normal sigue funcionando tal cual. Solo cuando el extra
       está marcado interceptamos el envío para meter las dos líneas de una vez;
       si algo falla, se envía el formulario original sin el extra. */
    var bump = root.querySelector('[data-calmia-bump]');
    var form = root.querySelector('[data-calmia-form]');
    if (bump && form) {
      bump.closest('.calmia-bump').addEventListener('click', function () {
        setTimeout(function () {
          bump.closest('.calmia-bump').classList.toggle('is-on', bump.checked);
        }, 0);
      });
      form.addEventListener('submit', function (e) {
        if (!bump.checked) return;
        e.preventDefault();
        var mainId = parseInt(idField.value, 10);
        var qty = parseInt(qtyField ? qtyField.value : '1', 10) || 1;
        var dest = returnField ? returnField.value : '/cart';
        fetch(window.Shopify && window.Shopify.routes ? window.Shopify.routes.root + 'cart/add.js' : '/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            items: [
              { id: mainId, quantity: qty },
              { id: parseInt(bump.value, 10), quantity: 1 }
            ]
          })
        })
          .then(function (r) { if (!r.ok) throw new Error('add failed'); return r.json(); })
          .then(function () { window.location.href = dest; })
          .catch(function () { bump.checked = false; form.submit(); });
      });
    }

    /* ---- Stock real ----
       Sale del inventario de Shopify, así que baja solo según vendes. */
    var stockBox = root.querySelector('[data-calmia-stock]');
    var stockThreshold = {{ section.settings.stock_threshold | default: 25 }};
    function paintStock() {
      if (!stockBox || !currentVariant) return;
      var q = currentVariant.qty;
      if (q === null || q === undefined || q <= 0 || q > stockThreshold) {
        stockBox.hidden = true;
        return;
      }
      stockBox.hidden = false;
      var n = stockBox.querySelector('[data-calmia-stock-qty]');
      var name = stockBox.querySelector('[data-calmia-stock-variant]');
      var bar = stockBox.querySelector('[data-calmia-stock-bar]');
      if (n) n.textContent = q;
      if (name) name.textContent = currentVariant.title || '';
      if (bar) bar.style.width = Math.max(8, Math.round(q * 100 / stockThreshold)) + '%';
    }

    /* ---- Corte de almacén ----
       Cuenta atrás real hasta la hora de corte del día. Se reinicia sola cada
       jornada porque el corte es un hecho, no una oferta que caduca. */
    var cutoff = root.querySelector('[data-calmia-cutoff]');
    if (cutoff) {
      var tzRaw = cutoff.getAttribute('data-tz') || '+0000';
      var cutHour = parseInt(cutoff.getAttribute('data-hour'), 10);
      var onlyWeekdays = cutoff.getAttribute('data-weekdays') === 'true';
      var days = ['domingo', 'lunes', 'martes', 'miércoles', 'jueves', 'viernes', 'sábado'];
      var timeEl = cutoff.querySelector('[data-calmia-cutoff-time]');
      var whenEl = cutoff.querySelector('[data-calmia-cutoff-when]');
      var txtToday = {{ section.settings.cutoff_today | json }};
      var txtOther = {{ section.settings.cutoff_other | json }};

      function shopNow() {
        var m = /^([+-])(\d{2})(\d{2})$/.exec(tzRaw);
        var offMin = m ? (m[1] === '-' ? -1 : 1) * (parseInt(m[2], 10) * 60 + parseInt(m[3], 10)) : 0;
        var now = new Date();
        return new Date(now.getTime() + offMin * 60000 + now.getTimezoneOffset() * 60000);
      }
      function isWorkday(d) { return !onlyWeekdays || (d.getDay() !== 0 && d.getDay() !== 6); }

      function tickCutoff() {
        var now = shopNow();
        var target = new Date(now);
        target.setHours(cutHour, 0, 0, 0);
        var shipsToday = now < target && isWorkday(now);
        if (!shipsToday) {
          do { target.setDate(target.getDate() + 1); } while (!isWorkday(target));
        }
        var left = target - now;
        if (left < 0) return;
        var mins = Math.floor(left / 60000);
        var h = Math.floor(mins / 60);
        var mm = mins % 60;
        if (timeEl) timeEl.textContent = h > 0 ? h + ' h ' + mm + ' min' : mm + ' min';
        if (whenEl) whenEl.textContent = shipsToday ? txtToday : txtOther.replace('[dia]', days[target.getDay()]);
        cutoff.hidden = false;
      }
      tickCutoff();
      setInterval(tickCutoff, 30000);
    }

    /* Estado inicial */
    var startId = idField ? parseInt(idField.value, 10) : null;
    data.variants.forEach(function (v) { if (v.id === startId) currentVariant = v; });
    if (!currentVariant && data.variants.length) currentVariant = data.variants[0];
    paintPacks();
    applyPack();
    paintStock();
  })();
</script>

