{%- comment -%} Calmia · Barra de compra fija (móvil y escritorio) {%- endcomment -%}
{% render 'calmia-base' %}

{%- liquid
  assign p = product
  if section.settings.product != blank
    assign p = section.settings.product
  endif
  assign cv = p.selected_or_first_available_variant

  assign meses = 'ene,feb,mar,abr,may,jun,jul,ago,sep,oct,nov,dic' | split: ','
  assign now_ts = 'now' | date: '%s' | times: 1
  assign min_ts = section.settings.delivery_min | times: 86400 | plus: now_ts
  assign max_ts = section.settings.delivery_max | times: 86400 | plus: now_ts
  assign mi = min_ts | date: '%-m' | minus: 1
  assign ma = max_ts | date: '%-m' | minus: 1
  assign da = min_ts | date: '%-d'
  assign db = max_ts | date: '%-d'
  if mi == ma
    assign eta_range = da | append: '–' | append: db | append: ' ' | append: meses[ma]
  else
    assign eta_range = da | append: ' ' | append: meses[mi] | append: ' – ' | append: db | append: ' ' | append: meses[ma]
  endif
-%}

{%- if p != blank -%}
  <div class="cal calmia-sticky" id="calmia-sticky-{{ section.id }}" data-calmia-sticky hidden>
    <div class="calmia-sticky__inner">
      {%- if p.featured_media -%}
        <img class="calmia-sticky__img" src="{{ p.featured_media | image_url: width: 160 }}" alt="" width="160" height="160" loading="lazy">
      {%- endif -%}
      <div class="calmia-sticky__info">
        <p class="calmia-sticky__title">{{ section.settings.short_title | default: p.title }}</p>
        <p class="calmia-sticky__price">
          {%- if cv.compare_at_price > cv.price -%}<s>{{ cv.compare_at_price | money }}</s>{%- endif -%}
          <b data-calmia-sticky-price>{{ cv.price | money }}</b>
        </p>
      </div>
      {%- if section.settings.cta_target == 'anchor' -%}
        <a href="{{ section.settings.cta_anchor }}" class="cal-btn calmia-sticky__btn">{{ section.settings.cta_text }}</a>
      {%- else -%}
      <form method="post" action="{{ routes.cart_add_url }}" class="calmia-sticky__form" enctype="multipart/form-data">
        <input type="hidden" name="form_type" value="product">
        <input type="hidden" name="utf8" value="✓">
        <input type="hidden" name="quantity" value="1" data-calmia-sticky-qty>
        <input type="hidden" name="id" value="{{ cv.id }}" data-calmia-sticky-id>
        {%- if section.settings.cta_target == 'checkout' -%}
          <input type="hidden" name="return_to" value="/checkout" data-calmia-sticky-return data-base="/checkout">
        {%- elsif section.settings.cta_target == 'cart' -%}
          <input type="hidden" name="return_to" value="/cart" data-calmia-sticky-return data-base="/cart">
        {%- endif -%}
        <button type="submit" name="add" class="cal-btn calmia-sticky__btn">{{ section.settings.cta_text }}</button>
      </form>
      {%- endif -%}
    </div>

    {%- if section.settings.show_eta -%}
      <p class="calmia-sticky__eta">
        {% render 'calmia-icon', icon: 'truck', size: 15 %}
        {{ section.settings.eta_text }} <b>{{ eta_range }}</b>
      </p>
    {%- endif -%}
  </div>

  <style>
    .calmia-sticky {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 60;
      background: rgba(255, 255, 255, 0.96);
      backdrop-filter: blur(10px);
      border-top: 1px solid var(--cal-line);
      box-shadow: 0 -8px 28px rgba(180, 110, 128, 0.14);
      transform: translateY(110%);
      transition: transform 0.28s ease;
      padding: 10px 0 calc(10px + env(safe-area-inset-bottom));
    }
    .calmia-sticky.is-visible { transform: translateY(0); }
    .calmia-sticky__inner {
      max-width: var(--cal-max);
      margin: 0 auto;
      padding: 0 14px;
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: 12px;
      align-items: center;
    }
    .calmia-sticky__img { width: 46px; height: 46px; border-radius: 10px; object-fit: cover; }
    .calmia-sticky__title {
      font-size: 13.5px;
      font-weight: 600;
      margin: 0;
      line-height: 1.2;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .calmia-sticky__price { margin: 2px 0 0; font-size: 13px; display: flex; gap: 6px; align-items: baseline; }
    .calmia-sticky__price s { color: var(--cal-ink-3); }
    .calmia-sticky__price b { color: var(--cal-pink); font-size: 15px; }
    .calmia-sticky__form { margin: 0; }
    .calmia-sticky__btn { width: auto; padding: 13px 22px; font-size: 15px; border-radius: 14px; white-space: nowrap; }
    .calmia-sticky__eta {
      max-width: var(--cal-max);
      margin: 8px auto 0;
      padding: 8px 14px 0;
      border-top: 1px solid var(--cal-line);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
      font-size: 12.5px;
      color: var(--cal-ink-2);
      text-align: center;
      line-height: 1.3;
    }
    .calmia-sticky__eta svg { color: #2f8b57; flex: 0 0 auto; }
    .calmia-sticky__eta b { font-weight: 700; color: var(--cal-ink); white-space: nowrap; }
    @media (min-width: 750px) {
      .calmia-sticky__img { width: 54px; height: 54px; }
      .calmia-sticky__title { font-size: 15px; }
      .calmia-sticky__btn { padding: 15px 34px; font-size: 17px; }
      .calmia-sticky__eta { font-size: 13.5px; }
    }
  </style>

  <script>
    (function () {
      var bar = document.getElementById('calmia-sticky-{{ section.id }}');
      if (!bar) return;
      bar.hidden = false;
      var threshold = {{ section.settings.offset | default: 600 }};
      function onScroll() {
        var atBottom = (window.innerHeight + window.scrollY) >= (document.body.offsetHeight - 220);
        if (window.scrollY >= threshold && !atBottom) {
          bar.classList.add('is-visible');
        } else {
          bar.classList.remove('is-visible');
        }
      }
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Calmia · Barra fija",
  "tag": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "Producto (vacío = el de la página)" },
    { "type": "text", "id": "short_title", "label": "Nombre corto", "default": "ReliefPath™ Ventosas Inteligentes" },
    { "type": "text", "id": "cta_text", "label": "Texto del botón", "default": "Comprar ahora" },
    {
      "type": "select",
      "id": "cta_target",
      "label": "Al pulsar el botón",
      "options": [
        { "value": "checkout", "label": "Ir directo al pago" },
        { "value": "cart", "label": "Ir al carrito" },
        { "value": "anchor", "label": "Llevar al formulario de contrareembolso" },
        { "value": "default", "label": "Comportamiento del tema" }
      ],
      "default": "checkout"
    },
    { "type": "text", "id": "cta_anchor", "label": "Enlace del formulario", "default": "#shopify-section-contrareembolso", "info": "Solo se usa con la opción «Llevar al formulario de contrareembolso»." },
    { "type": "range", "id": "offset", "label": "Aparece tras (px de scroll)", "info": "0 = visible desde el primer momento. Ojo: en móvil la barra ocupa unos 80 px de la primera pantalla y puede tapar el precio; 150 la hace aparecer al primer roce sin comerse el hueco.", "min": 0, "max": 2000, "step": 50, "unit": "px", "default": 600 },
    { "type": "header", "content": "Fecha de entrega" },
    { "type": "checkbox", "id": "show_eta", "label": "Mostrar la fecha bajo el botón", "default": true, "info": "Va pegada al botón durante todo el scroll. Es donde se decide la compra." },
    { "type": "text", "id": "eta_text", "label": "Texto", "default": "Pídelo hoy y lo tienes entre el" },
    { "type": "range", "id": "delivery_min", "label": "Días mínimos", "min": 1, "max": 30, "step": 1, "unit": "d", "default": 6, "info": "Ponlos iguales que en el hero para que no se contradigan." },
    { "type": "range", "id": "delivery_max", "label": "Días máximos", "min": 2, "max": 45, "step": 1, "unit": "d", "default": 12 }
  ],
  "presets": [{ "name": "Calmia · Barra fija" }]
}
{% endschema %}
