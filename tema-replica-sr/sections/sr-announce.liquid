{% render 'sr-head' %}
<div class="sr sr-bar" style="--sr-bar-bg:{{ section.settings.bg }};--sr-bar-fg:{{ section.settings.color }}" data-sr-bar>
  <div class="sr-w sr-bar__in">
    {%- for b in section.blocks -%}
      {%- if b.settings.link != blank -%}
        <a class="sr-bar__msg{% if forloop.first %} is-on{% endif %}" href="{{ b.settings.link }}" {{ b.shopify_attributes }}>{% render 'sr-icon', name: b.settings.icon %}<span>{{ b.settings.text }}</span></a>
      {%- else -%}
        <span class="sr-bar__msg{% if forloop.first %} is-on{% endif %}" {{ b.shopify_attributes }}>{% render 'sr-icon', name: b.settings.icon %}<span>{{ b.settings.text }}</span></span>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>
{%- if section.blocks.size > 1 -%}
<script>
(function(){
  var bar=document.currentScript.previousElementSibling; if(!bar) return;
  var m=bar.querySelectorAll('.sr-bar__msg'),i=0;
  if(window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  setInterval(function(){ if(window.innerWidth>=990) return; m[i].classList.remove('is-on'); i=(i+1)%m.length; m[i].classList.add('is-on'); },{{ section.settings.speed | times: 1000 }});
})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "SR · Barra de anuncios",
  "tag": "div",
  "class": "sr-sec-announce",
  "settings": [
    { "type": "color", "id": "bg", "label": "Fondo", "default": "#0f2640" },
    { "type": "color", "id": "color", "label": "Texto", "default": "#ffffff" },
    { "type": "range", "id": "speed", "label": "Segundos por mensaje (móvil)", "min": 2, "max": 10, "step": 1, "default": 4 }
  ],
  "blocks": [
    {
      "type": "msg",
      "name": "Mensaje",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icono", "default": "truck", "options": [
          { "value": "truck", "label": "Envío" }, { "value": "cash", "label": "Efectivo" }, { "value": "refresh", "label": "Devolución" },
          { "value": "shield", "label": "Escudo" }, { "value": "chat", "label": "Chat" }, { "value": "book", "label": "Estudio" }, { "value": "spark", "label": "Destello" }
        ] },
        { "type": "text", "id": "text", "label": "Texto", "default": "Envío estándar gratis en España" },
        { "type": "url", "id": "link", "label": "Enlace (opcional)" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [ { "name": "SR · Barra de anuncios", "blocks": [ { "type": "msg" } ] } ]
}
{% endschema %}