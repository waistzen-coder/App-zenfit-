{% render 'sr-head' %}
{%- liquid
  assign p = section.settings.product | default: product
  if p != blank
    assign v = p.selected_or_first_available_variant
    assign base_unit = v.price
    if v.compare_at_price > v.price
      assign base_unit = v.compare_at_price
    endif
  endif
  assign fee = 0
  assign fee_p = section.settings.fee_product
  if fee_p != blank
    assign fee_v = fee_p.selected_or_first_available_variant
    if fee_v.available
      assign fee = fee_v.price
    endif
  endif
  assign gal = section.blocks | where: 'type', 'image'
  assign bullets = section.blocks | where: 'type', 'bullet'
  assign packs = section.blocks | where: 'type', 'pack'
  assign seals = section.blocks | where: 'type', 'seal'
  assign accs = section.blocks | where: 'type', 'accordion'
  assign default_pack = 0
  for b in packs
    if b.settings.default
      assign default_pack = forloop.index0
    endif
  endfor
-%}
{%- if p != blank -%}
<section class="sr sr-pdp" id="sr-pdp-{{ section.id }}" data-sr-pdp data-url="{{ p.url }}" data-variant="{{ v.id }}">
  <div class="sr-w sr-pdp__grid">

    <div class="sr-pdp__gal">
      <div class="sr-gal__track" data-sr-track>
        {%- if gal.size > 0 -%}
          {%- for b in gal -%}
            <div class="sr-gal__slide" {{ b.shopify_attributes }}>
              {%- if forloop.first -%}
                {% render 'sr-photo', image: b.settings.image, ratio: 'sq', fit: b.settings.fit, tag: b.settings.tag, tag_icon: b.settings.tag_icon, pins: b.settings.pins, alt: b.settings.image.alt, eager: true, sizes: '(min-width: 990px) 55vw, 100vw' %}
              {%- else -%}
                {% render 'sr-photo', image: b.settings.image, ratio: 'sq', fit: b.settings.fit, tag: b.settings.tag, tag_icon: b.settings.tag_icon, pins: b.settings.pins, alt: b.settings.image.alt, sizes: '(min-width: 990px) 55vw, 100vw' %}
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- for m in p.media -%}{%- if m.media_type == 'image' -%}
            <div class="sr-gal__slide">
              {%- if forloop.first -%}
                {% render 'sr-photo', image: m.preview_image, ratio: 'sq', alt: m.alt, eager: true, sizes: '(min-width: 990px) 55vw, 100vw' %}
              {%- else -%}
                {% render 'sr-photo', image: m.preview_image, ratio: 'sq', alt: m.alt, sizes: '(min-width: 990px) 55vw, 100vw' %}
              {%- endif -%}
            </div>
          {%- endif -%}{%- endfor -%}
        {%- endif -%}
      </div>
      <div class="sr-gal__dots" data-sr-dots></div>
      <div class="sr-gal__thumbs" data-sr-thumbs>
        {%- if gal.size > 0 -%}
          {%- for b in gal -%}{%- if b.settings.image != blank -%}
            <button type="button" aria-label="Ver imagen {{ forloop.index }}"{% if forloop.first %} class="is-on"{% endif %}>{{ b.settings.image | image_url: width: 180 | image_tag: loading: 'lazy', alt: '' }}</button>
          {%- endif -%}{%- endfor -%}
        {%- else -%}
          {%- for m in p.media -%}{%- if m.media_type == 'image' -%}
            <button type="button" aria-label="Ver imagen {{ forloop.index }}"{% if forloop.first %} class="is-on"{% endif %}>{{ m.preview_image | image_url: width: 180 | image_tag: loading: 'lazy', alt: '' }}</button>
          {%- endif -%}{%- endfor -%}
        {%- endif -%}
      </div>
    </div>

    <div class="sr-pdp__info">
      {%- if section.settings.badges != blank -%}
        <div class="sr-badges">{%- assign bs = section.settings.badges | split: '|' -%}{%- for x in bs -%}<span class="sr-badge">{{ x | strip }}</span>{%- endfor -%}</div>
      {%- endif -%}
      {%- if section.settings.is_page_title -%}
        <h1 class="sr-h1">{{ section.settings.heading | default: p.title }}</h1>
      {%- else -%}
        <h2 class="sr-h1">{{ section.settings.heading | default: p.title }}</h2>
      {%- endif -%}
      {%- assign rv = p.metafields.reviews.rating.value -%}
      {%- if rv and rv.rating -%}
        <div class="sr-rating"><span class="sr-stars">{% for i in (1..5) %}{% render 'sr-icon', name: 'star' %}{% endfor %}</span><strong>{{ rv.rating | round: 1 }}</strong> · {{ p.metafields.reviews.rating_count.value }} reseñas</div>
      {%- endif -%}
      {%- if section.settings.sub != blank -%}<p class="sr-pdp__sub">{{ section.settings.sub }}</p>{%- endif -%}

      <div class="sr-price">
        <span class="sr-price__now">{{ v.price | money }}</span>
        {%- if v.compare_at_price > v.price -%}
          <span class="sr-price__was">{{ v.compare_at_price | money }}</span>
          <span class="sr-price__off">−{{ v.compare_at_price | minus: v.price | times: 100 | divided_by: v.compare_at_price }} %</span>
        {%- endif -%}
      </div>
      {%- if section.settings.price_note != blank -%}<p class="sr-note" style="margin-top:6px">{{ section.settings.price_note }}</p>{%- endif -%}

      {%- if bullets.size > 0 -%}
        <ul class="sr-checks">
          {%- for b in bullets -%}<li {{ b.shopify_attributes }}>{% render 'sr-icon', name: 'check-circle' %}<span>{{ b.settings.text }}</span></li>{%- endfor -%}
        </ul>
      {%- endif -%}

      <div class="sr-buy" id="comprar" data-sr-buy-box>
        {%- if packs.size > 0 -%}
          <p class="sr-buy__title">{{ section.settings.packs_title }}</p>
          <div class="sr-packs" role="radiogroup" aria-label="{{ section.settings.packs_title | escape }}">
            {%- for b in packs -%}
              {%- liquid
                assign q = b.settings.qty | at_least: 1
                assign gross = v.price | times: q
                assign unit_cut = v.price | times: b.settings.discount | divided_by: 100.0 | floor
                assign cut = unit_cut | times: q
                assign net = gross | minus: cut
                assign unit = net | divided_by: q
                assign cross = base_unit | times: q
                assign save = cross | minus: net
                assign codnet = net | plus: fee
                assign off = true
                if v.inventory_management != blank and v.inventory_policy == 'deny' and q > v.inventory_quantity
                  assign off = false
                endif
              -%}
              <label class="sr-pack{% if forloop.index0 == default_pack %} is-on{% endif %}{% if b.settings.highlight %} sr-pack--hot{% endif %}" {{ b.shopify_attributes }}>
                <input type="radio" name="sr-pack-{{ section.id }}" value="{{ q }}"
                  data-label="{{ b.settings.label | default: q | escape }}"
                  data-card="{{ net | money | strip_html | escape }}"
                  data-cod="{{ codnet | money | strip_html | escape }}"
                  data-save="{{ save | money | strip_html | escape }}"
                  {% if forloop.index0 == default_pack %}checked{% endif %}{% unless off and v.available %} disabled{% endunless %}>
                <span class="sr-pack__dot" aria-hidden="true"></span>
                <span class="sr-pack__main">
                  <b>{{ b.settings.label }}</b>
                  {%- if b.settings.sublabel != blank -%}<span>{{ b.settings.sublabel }}</span>{%- endif -%}
                </span>
                <span class="sr-pack__price">
                  <b>{{ net | money }}</b>
                  {%- if cross > net -%}<s>{{ cross | money }}</s>{%- endif -%}
                  {%- if q > 1 -%}<i>{{ unit | money }}/ud</i>{%- endif -%}
                </span>
                {%- if b.settings.tag != blank -%}<em class="sr-pack__tag">{{ b.settings.tag }}</em>{%- endif -%}
              </label>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if v.available -%}
          <button type="button" class="sr-btn sr-btn--block sr-buy__card" data-sr-card>
            {% render 'sr-icon', name: 'lock' %}<span data-sr-card-text>{{ section.settings.card_text }}</span><span class="sr-buy__amt" data-sr-card-price>{{ v.price | money }}</span>
          </button>
          {%- if fee > 0 and section.settings.cod_text != blank -%}
            <button type="button" class="sr-btn sr-btn--block sr-btn--cod" data-sr-cod>
              {% render 'sr-icon', name: 'cash' %}<span>{{ section.settings.cod_text }}</span><span class="sr-buy__amt" data-sr-cod-price>{{ v.price | plus: fee | money }}</span>
            </button>
          {%- endif -%}
          <p class="sr-note sr-center" data-sr-err hidden>No hemos podido preparar el pedido. Recarga la página o escríbenos.</p>
        {%- else -%}
          <button type="button" class="sr-btn sr-btn--block" disabled>{{ section.settings.soldout_text }}</button>
        {%- endif -%}
        {%- if section.settings.under != blank -%}<p class="sr-pdp__under">{{ section.settings.under }}</p>{%- endif -%}
      </div>

      {%- if seals.size > 0 -%}
        <div class="sr-seals">
          {%- for b in seals -%}<div {{ b.shopify_attributes }}>{% render 'sr-icon', name: b.settings.icon %}<span>{{ b.settings.text }}</span></div>{%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.show_payment -%}
        <div class="sr-pay" aria-label="Formas de pago">{%- for t in shop.enabled_payment_types -%}{{ t | payment_type_svg_tag }}{%- endfor -%}</div>
      {%- endif -%}

      {%- if accs.size > 0 -%}
        <div class="sr-acc">
          {%- for b in accs -%}
            <details {{ b.shopify_attributes }}>
              <summary>{% render 'sr-icon', name: b.settings.icon %}<span>{{ b.settings.title }}</span>{% render 'sr-icon', name: 'plus' %}</summary>
              <div class="sr-acc__c sr-rte">{{ b.settings.content }}</div>
            </details>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{%- if section.settings.show_schema -%}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"Product","name":{{ p.title | json }},"url":{{ request.origin | append: p.url | json }},{% if p.featured_image %}"image":[{{ p.featured_image | image_url: width: 1200 | prepend: 'https:' | json }}],{% endif %}"description":{{ p.description | strip_html | truncatewords: 60 | json }},"brand":{"@type":"Brand","name":"ReliefPath"},"sku":{{ v.sku | json }},"offers":{"@type":"Offer","priceCurrency":{{ cart.currency.iso_code | json }},"price":{{ v.price | divided_by: 100.0 | json }},"availability":"https://schema.org/{% if v.available %}InStock{% else %}OutOfStock{% endif %}","url":{{ request.origin | append: p.url | json }}}}
</script>
{%- endif -%}

<script>
(function(){
  var root=document.getElementById('sr-pdp-{{ section.id }}'); if(!root) return;
  var ROOT=(window.Shopify&&Shopify.routes&&Shopify.routes.root)||'/';

  /* ---------- Galería ---------- */
  var track=root.querySelector('[data-sr-track]'),slides=track?track.children:[],dots=root.querySelector('[data-sr-dots]'),thumbs=root.querySelectorAll('[data-sr-thumbs] button');
  function go(i){ if(!slides[i]) return; track.scrollTo({left:slides[i].offsetLeft-track.offsetLeft,behavior:'smooth'}); }
  if(dots && slides.length>1){ for(var i=0;i<slides.length;i++){ (function(i){ var b=document.createElement('button'); b.type='button'; b.setAttribute('aria-label','Imagen '+(i+1)); if(i===0) b.className='is-on'; b.addEventListener('click',function(){go(i)}); dots.appendChild(b); })(i); } }
  thumbs.forEach(function(t,i){ t.addEventListener('click',function(){ go(i); }); });
  var tick;
  if(track) track.addEventListener('scroll',function(){ clearTimeout(tick); tick=setTimeout(function(){
    var i=Math.round(track.scrollLeft/track.clientWidth);
    if(dots) Array.prototype.forEach.call(dots.children,function(d,k){ d.classList.toggle('is-on',k===i); });
    thumbs.forEach(function(t,k){ t.classList.toggle('is-on',k===i); });
  },60); },{passive:true});

  /* ---------- Caja de compra ---------- */
  var box=root.querySelector('[data-sr-buy-box]'); if(!box) return;
  var inputs=[].slice.call(box.querySelectorAll('input[name^="sr-pack-"]'));
  var cardBtn=box.querySelector('[data-sr-card]'),codBtn=box.querySelector('[data-sr-cod]'),err=box.querySelector('[data-sr-err]');
  var CARD_TEXT={{ section.settings.card_text | json }};
  var syncing=false;

  function current(){
    var i=box.querySelector('input[name^="sr-pack-"]:checked')||inputs[0];
    if(!i) return {qty:1,label:'1 unidad',card:{{ v.price | money | strip_html | json }},cod:{{ v.price | plus: fee | money | strip_html | json }}};
    return {qty:+i.value,label:i.dataset.label,card:i.dataset.card,cod:i.dataset.cod,save:i.dataset.save};
  }
  function paint(){
    var pk=current();
    inputs.forEach(function(i){ i.closest('.sr-pack').classList.toggle('is-on',i.checked); });
    var cp=box.querySelector('[data-sr-card-price]'); if(cp) cp.textContent=pk.card;
    var dp=box.querySelector('[data-sr-cod-price]'); if(dp) dp.textContent=pk.cod;
    document.dispatchEvent(new CustomEvent('sr:pack',{detail:pk}));
    return pk;
  }

  /* La caja de contrareembolso de más abajo (calmia-cod) tiene su propio
     selector de packs. Se mantienen los dos en el mismo pack, en los dos
     sentidos, emparejándolos por número de unidades. */
  function codRoot(){ return document.querySelector('[data-calmia-cod]'); }
  function codIndexFor(qty){
    var c=codRoot(); if(!c) return -1;
    try{ var cfg=JSON.parse(c.querySelector('[data-calmia-cod-config]').textContent); for(var k=0;k<cfg.packs.length;k++){ if(+cfg.packs[k].qty===qty) return k; } }catch(e){}
    return -1;
  }
  function pushToCod(qty,way){
    var c=codRoot(); if(!c) return false;
    var idx=codIndexFor(qty);
    syncing=true;
    if(idx>-1){ var r=c.querySelector('input[name^="calmia-pack-"][value="'+idx+'"]'); if(r && !r.disabled && !r.checked) r.click(); }
    if(way){ var w=c.querySelector('input[name^="calmia-way-"][value="'+way+'"]'); if(w && !w.checked) w.click(); }
    syncing=false;
    return true;
  }
  function selectQty(qty){
    var hit=inputs.filter(function(i){ return +i.value===qty && !i.disabled; })[0];
    if(hit){ hit.checked=true; paint(); }
  }
  document.addEventListener('change',function(e){
    var t=e.target; if(syncing||!t||!t.name) return;
    if(t.name.indexOf('calmia-pack-')===0 && t.checked){
      var c=codRoot(); try{ var cfg=JSON.parse(c.querySelector('[data-calmia-cod-config]').textContent); selectQty(+cfg.packs[+t.value].qty); }catch(x){}
    }
  });
  inputs.forEach(function(i){ i.addEventListener('change',function(){ var pk=paint(); pushToCod(pk.qty); }); });

  function fire(name){ try{ if(window.fbq) window.fbq('track',name); if(window.dataLayer) window.dataLayer.push({event:'sr_'+name.toLowerCase()}); }catch(e){} }

  if(cardBtn) cardBtn.addEventListener('click',function(){
    var pk=current();
    var params={
      'locale':'es',
      'attributes[Preferencia de pago del formulario]':'Pago online',
      'attributes[Pack]':pk.label,
      'attributes[Total previsto en formulario]':pk.card,
      'note':'Preferencia: pago online. Consultar método de pago, dirección y total definitivos del pedido confirmado.'
    };
    var qs=Object.keys(params).map(function(k){ return encodeURIComponent(k)+'='+encodeURIComponent(params[k]); }).join('&');
    cardBtn.disabled=true;
    var t=cardBtn.querySelector('[data-sr-card-text]'); if(t) t.textContent='Un momento…';
    fire('InitiateCheckout');
    window.location.href=ROOT.replace(/\/$/,'')+'/cart/'+root.dataset.variant+':'+pk.qty+'?'+qs;
    setTimeout(function(){ cardBtn.disabled=false; if(t) t.textContent=CARD_TEXT; if(err) err.hidden=false; },8000);
  });

  function goCod(scroll){
    var pk=current();
    if(pushToCod(pk.qty,'cod')){
      if(scroll){
        var c=codRoot(), target=c.querySelector('[data-calmia-cod-form]')||c;
        setTimeout(function(){ target.scrollIntoView({behavior:'smooth',block:'start'}); },40);
      }
    } else {
      window.location.href=root.dataset.url+'?pack='+pk.qty+'&pago=cod#shopify-section-contrareembolso';
    }
  }
  if(codBtn) codBtn.addEventListener('click',function(){ fire('AddPaymentInfo'); goCod(true); });

  /* Enlaces desde la portada: ?pack=2&pago=cod llegan con todo elegido. */
  var qp=new URLSearchParams(window.location.search);
  var startQty=parseInt(qp.get('pack'),10);
  paint();
  window.addEventListener('load',function(){
    if(startQty) selectQty(startQty);
    pushToCod(current().qty, qp.get('pago')==='cod'?'cod':null);
    if(qp.get('pago')==='cod'){ var c=codRoot(); if(c){ var f=c.querySelector('[data-calmia-cod-form]')||c; setTimeout(function(){ f.scrollIntoView({block:'start'}); },60); } }
  });
})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "SR · Ficha de producto",
  "tag": "div",
  "settings": [
    { "type": "product", "id": "product", "label": "Producto (vacío = el de la página)" },
    { "type": "product", "id": "fee_product", "label": "Producto del recargo de contrareembolso" },
    { "type": "checkbox", "id": "is_page_title", "label": "Es el título principal de la página (H1)", "default": true, "info": "Desmárcalo si usas esta sección en la portada." },
    { "type": "text", "id": "badges", "label": "Etiquetas (separadas por |)", "default": "Método Pausa|Para opositores" },
    { "type": "text", "id": "heading", "label": "Título (vacío = nombre del producto)" },
    { "type": "textarea", "id": "sub", "label": "Subtítulo" },
    { "type": "text", "id": "price_note", "label": "Nota bajo el precio" },
    { "type": "header", "content": "Caja de compra" },
    { "type": "text", "id": "packs_title", "label": "Título de los packs", "default": "Elige tu pack" },
    { "type": "text", "id": "card_text", "label": "Botón de pago online", "default": "Comprar ahora" },
    { "type": "text", "id": "cod_text", "label": "Botón de contrareembolso", "default": "Pagar al recibirlo" },
    { "type": "text", "id": "soldout_text", "label": "Agotado", "default": "Agotado" },
    { "type": "text", "id": "under", "label": "Texto bajo los botones" },
    { "type": "checkbox", "id": "show_payment", "label": "Mostrar formas de pago", "default": true },
    { "type": "checkbox", "id": "show_schema", "label": "Datos estructurados de producto", "default": true }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Foto de galería",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen" },
        { "type": "select", "id": "fit", "label": "Encaje", "default": "cover", "options": [ { "value": "cover", "label": "Llenar" }, { "value": "contain", "label": "Producto entero" } ] },
        { "type": "text", "id": "tag", "label": "Etiqueta" },
        { "type": "select", "id": "tag_icon", "label": "Icono de la etiqueta", "default": "spark", "options": [
          { "value": "spark", "label": "Destello" }, { "value": "sun", "label": "Luz" }, { "value": "flame", "label": "Calor" }, { "value": "wave", "label": "Succión" },
          { "value": "timer", "label": "Temporizador" }, { "value": "moon", "label": "Luna" }, { "value": "book", "label": "Libro" }, { "value": "box", "label": "Caja" }, { "value": "truck", "label": "Envío" }, { "value": "check-circle", "label": "Check" }
        ] },
        { "type": "text", "id": "pins", "label": "Llamadas", "info": "x,y,texto | x,y,texto" }
      ]
    },
    { "type": "bullet", "name": "Viñeta", "settings": [ { "type": "text", "id": "text", "label": "Texto" } ] },
    {
      "type": "pack",
      "name": "Pack",
      "settings": [
        { "type": "number", "id": "qty", "label": "Unidades", "default": 1 },
        { "type": "number", "id": "discount", "label": "Descuento %", "default": 0, "info": "Tiene que coincidir con el descuento automático de la tienda." },
        { "type": "text", "id": "label", "label": "Nombre", "default": "1 unidad" },
        { "type": "text", "id": "sublabel", "label": "Subtexto" },
        { "type": "text", "id": "tag", "label": "Etiqueta" },
        { "type": "checkbox", "id": "highlight", "label": "Destacado", "default": false },
        { "type": "checkbox", "id": "default", "label": "Elegido al entrar", "default": false }
      ]
    },
    {
      "type": "seal",
      "name": "Sello",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icono", "default": "truck", "options": [
          { "value": "truck", "label": "Envío" }, { "value": "cash", "label": "Efectivo" }, { "value": "refresh", "label": "Devolución" },
          { "value": "shield", "label": "Escudo" }, { "value": "chat", "label": "Chat" }, { "value": "lock", "label": "Candado" }
        ] },
        { "type": "text", "id": "text", "label": "Texto" }
      ]
    },
    {
      "type": "accordion",
      "name": "Desplegable",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icono", "default": "info", "options": [
          { "value": "info", "label": "Información" }, { "value": "truck", "label": "Envío" }, { "value": "refresh", "label": "Devolución" },
          { "value": "box", "label": "Caja" }, { "value": "book", "label": "Manual" }, { "value": "shield", "label": "Escudo" }
        ] },
        { "type": "text", "id": "title", "label": "Título" },
        { "type": "richtext", "id": "content", "label": "Contenido" }
      ]
    }
  ],
  "presets": [ { "name": "SR · Ficha de producto" } ]
}
{% endschema %}
