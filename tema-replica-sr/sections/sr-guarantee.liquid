{% render 'sr-head' %}
<section class="sr sr-sec sr-guar" style="background:{{ section.settings.bg }}">
  <div class="sr-w">
    <div class="sr-guar__card">
      <div class="sr-seal"><div><b>{{ section.settings.number }}</b><span>{{ section.settings.number_label }}</span></div></div>
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="sr-eyebrow" style="color:#ffb4ae">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="sr-h2">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<div class="sr-rte" style="color:#cfdae6;margin-top:10px">{{ section.settings.text }}</div>{%- endif -%}
      </div>
      {%- if section.settings.cta_text != blank -%}<div><a class="sr-btn" href="{{ section.settings.cta_link }}">{{ section.settings.cta_text }}</a></div>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "SR · Garantía",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "number", "label": "Número del sello", "default": "30" },
    { "type": "text", "id": "number_label", "label": "Texto del sello", "default": "días para devolverlo" },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Compra tranquila" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Si no es para ti, lo devuelves" },
    { "type": "richtext", "id": "text", "label": "Texto" },
    { "type": "text", "id": "cta_text", "label": "Botón" },
    { "type": "url", "id": "cta_link", "label": "Enlace del botón" },
    { "type": "color", "id": "bg", "label": "Fondo", "default": "#ffffff" }
  ],
  "presets": [ { "name": "SR · Garantía" } ]
}
{% endschema %}