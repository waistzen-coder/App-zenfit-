{%- comment -%}
  Calmia · Botón flotante de contacto.
  Se queda fijo abajo a la derecha, por encima de la barra de compra en móvil.
  No se pinta si no hay ni WhatsApp ni email configurados.
{%- endcomment -%}
{% render 'calmia-base' %}

{%- liquid
  assign wa = section.settings.whatsapp | remove: ' ' | remove: '+' | remove: '-'
  assign has_wa = false
  if wa != blank
    assign has_wa = true
  endif
  assign has_mail = false
  if section.settings.email != blank
    assign has_mail = true
  endif
-%}

{%- if has_wa or has_mail -%}
  {%- if has_wa -%}
    {%- assign href = 'https://wa.me/' | append: wa -%}
    {%- if section.settings.prefill != blank -%}
      {%- assign href = href | append: '?text=' | append: section.settings.prefill | url_encode -%}
    {%- endif -%}
  {%- else -%}
    {%- assign href = 'mailto:' | append: section.settings.email -%}
  {%- endif -%}

  <a
    class="cal calmia-chat{% if has_wa %} calmia-chat--wa{% endif %}"
    id="calmia-chat-{{ section.id }}"
    href="{{ href }}"
    {% if has_wa %}target="_blank" rel="noopener nofollow"{% endif %}
    aria-label="{{ section.settings.label | escape }}"
  >
    <span class="calmia-chat__ico">{% render 'calmia-icon', icon: 'chat', size: 20 %}</span>
    <span class="calmia-chat__txt">{{ section.settings.label }}</span>
  </a>

  <style>
    #calmia-chat-{{ section.id }} {
      position: fixed;
      right: 14px;
      bottom: {{ section.settings.offset_mobile }}px;
      z-index: 60;
      display: inline-flex;
      align-items: center;
      gap: 9px;
      padding: 11px 16px 11px 13px;
      border-radius: 999px;
      background: #fff;
      color: var(--cal-ink);
      text-decoration: none;
      font-size: 14px;
      font-weight: 600;
      box-shadow: 0 6px 24px rgba(31, 22, 25, 0.18);
      border: 1px solid var(--cal-line);
    }
    #calmia-chat-{{ section.id }}.calmia-chat--wa {
      background: #25d366;
      border-color: #1fb457;
      color: #fff;
    }
    #calmia-chat-{{ section.id }} .calmia-chat__ico { display: grid; place-items: center; }
    @media (max-width: 480px) {
      #calmia-chat-{{ section.id }} .calmia-chat__txt {
        {%- if section.settings.compact_mobile -%}
          position: absolute;
          width: 1px;
          height: 1px;
          overflow: hidden;
          clip: rect(0 0 0 0);
          white-space: nowrap;
        {%- endif -%}
      }
      {%- if section.settings.compact_mobile -%}
        #calmia-chat-{{ section.id }} { padding: 13px; }
      {%- endif -%}
    }
    @media (min-width: 750px) {
      #calmia-chat-{{ section.id }} { right: 22px; bottom: {{ section.settings.offset_desktop }}px; }
    }
  </style>
{%- endif -%}

{% schema %}
{
  "name": "Calmia · Botón de chat",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "whatsapp", "label": "WhatsApp (con prefijo)", "info": "Ej.: 34600111222. Si lo dejas vacío se usa el email." },
    { "type": "text", "id": "email", "label": "Email de respaldo", "default": "waistzen@gmail.com" },
    { "type": "text", "id": "label", "label": "Texto del botón", "default": "Escríbenos" },
    { "type": "textarea", "id": "prefill", "label": "Mensaje precargado", "info": "Solo para WhatsApp. Se abre con este texto ya escrito.", "default": "Hola, tengo una duda sobre el ReliefPath" },
    { "type": "header", "content": "Posición" },
    { "type": "range", "id": "offset_mobile", "label": "Altura en móvil", "min": 12, "max": 160, "step": 4, "unit": "px", "default": 88, "info": "Súbelo para que no lo tape la barra de compra fija." },
    { "type": "range", "id": "offset_desktop", "label": "Altura en escritorio", "min": 12, "max": 160, "step": 4, "unit": "px", "default": 24 },
    { "type": "checkbox", "id": "compact_mobile", "label": "Solo icono en móviles pequeños", "default": true }
  ],
  "presets": [{ "name": "Calmia · Botón de chat" }]
}
{% endschema %}
