{% render 'sr-head' %}
<section class="sr sr-sec sr-steps" style="background:{{ section.settings.bg }}">
  <div class="sr-w">
    <div class="sr-head sr-center">
      {%- if section.settings.eyebrow != blank -%}<p class="sr-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="sr-h2">{{ section.settings.heading }}{% if section.settings.heading_accent != blank %} <span class="sr-accent">{{ section.settings.heading_accent }}</span>{% endif %}</h2>
      {%- if section.settings.text != blank -%}<p class="sr-lead">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="sr-steps__grid">
      {%- for b in section.blocks -%}
        <div class="sr-step" {{ b.shopify_attributes }}>
          {% render 'sr-photo', image: b.settings.image, ratio: 'sq', tag: b.settings.tag, tag_light: true, pins: b.settings.pins, sizes: '(min-width: 750px) 33vw, 100vw' %}
          <h3 class="sr-h3"><span class="sr-step__n">{{ forloop.index }}</span>{{ b.settings.title }}</h3>
          <p>{{ b.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
    {%- if section.settings.note != blank -%}<p class="sr-note sr-center">{{ section.settings.note }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "SR · Cómo funciona",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Cómo funciona" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Tres pasos." },
    { "type": "text", "id": "heading_accent", "label": "Título (parte en color)", "default": "Cero complicaciones." },
    { "type": "textarea", "id": "text", "label": "Texto" },
    { "type": "text", "id": "note", "label": "Nota al pie" },
    { "type": "color", "id": "bg", "label": "Fondo", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Paso",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen" },
        { "type": "text", "id": "tag", "label": "Etiqueta de la foto" },
        { "type": "text", "id": "pins", "label": "Llamadas sobre la foto", "info": "x,y,texto | x,y,texto" },
        { "type": "text", "id": "title", "label": "Título" },
        { "type": "textarea", "id": "text", "label": "Texto" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [ { "name": "SR · Cómo funciona", "blocks": [ { "type": "step" }, { "type": "step" }, { "type": "step" } ] } ]
}
{% endschema %}