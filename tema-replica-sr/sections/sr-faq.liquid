{% render 'sr-head' %}
<section class="sr sr-sec sr-faq" style="background:{{ section.settings.bg }}">
  <div class="sr-w">
    <div class="sr-head sr-center">
      {%- if section.settings.eyebrow != blank -%}<p class="sr-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="sr-h2">{{ section.settings.heading }}{% if section.settings.heading_accent != blank %} <span class="sr-accent">{{ section.settings.heading_accent }}</span>{% endif %}</h2>
    </div>
    <div class="sr-faq__list">
      {%- for b in section.blocks -%}
        <details class="sr-faq__it" {% if forloop.first and section.settings.open_first %}open{% endif %} {{ b.shopify_attributes }}>
          <summary>{{ b.settings.question }}{% render 'sr-icon', name: 'plus' %}</summary>
          <div class="sr-faq__a sr-rte">{{ b.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
    {%- if section.settings.help != blank -%}<div class="sr-faq__help sr-rte">{{ section.settings.help }}</div>{%- endif -%}
  </div>
</section>
{%- if section.settings.schema and section.blocks.size > 0 -%}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{%- for b in section.blocks -%}{"@type":"Question","name":{{ b.settings.question | json }},"acceptedAnswer":{"@type":"Answer","text":{{ b.settings.answer | strip_html | json }}}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]}
</script>
{%- endif -%}

{% schema %}
{
  "name": "SR · Preguntas frecuentes",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Dudas" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Preguntas" },
    { "type": "text", "id": "heading_accent", "label": "Título (parte en color)", "default": "frecuentes" },
    { "type": "checkbox", "id": "open_first", "label": "Primera abierta", "default": true },
    { "type": "richtext", "id": "help", "label": "Texto de ayuda final" },
    { "type": "checkbox", "id": "schema", "label": "Datos estructurados para Google", "default": true },
    { "type": "color", "id": "bg", "label": "Fondo", "default": "#ffffff" }
  ],
  "blocks": [
    { "type": "q", "name": "Pregunta", "settings": [ { "type": "text", "id": "question", "label": "Pregunta" }, { "type": "richtext", "id": "answer", "label": "Respuesta" } ] }
  ],
  "presets": [ { "name": "SR · Preguntas frecuentes", "blocks": [ { "type": "q" }, { "type": "q" } ] } ]
}
{% endschema %}