{%- comment -%}
  Ficha de producto Lab, pensada para vender desde el móvil:
  galería → título → precio (el de primer pedido si hay código) → packs con
  lo que se ahorra → un botón principal «Comprar ahora» que va directo al
  checkout en español → «Pagar al recibirlo» → fecha de entrega estimada,
  devolución y garantía → formas de pago → acordeón. «Añadir al carrito»
  queda como opción secundaria. Barra fija de compra en móvil y escritorio y
  Product + Offer + Breadcrumb.
  Los importes de cada pack se calculan aquí; el JS solo los cambia de sitio.
  No hay precios tachados inventados: lo tachado es el precio de la unidad
  suelta, que es el que se cobra sin pack ni código.
{%- endcomment -%}
{%- liquid
  assign p = product
  assign v = p.selected_or_first_available_variant
  assign pid = 'LabPdp-' | append: section.id
  assign fee_p = settings.lab_fee_product
  assign is_fee = false
  if fee_p != blank and fee_p.id == p.id
    assign is_fee = true
  endif
  assign fee = 0
  if section.settings.cod and settings.lab_cod_fee and fee_p != blank and is_fee == false
    assign fee_v = fee_p.selected_or_first_available_variant
    if fee_v.available
      assign fee = fee_v.price
    endif
  endif
  assign tracked = false
  if v.inventory_management == 'shopify' and v.inventory_policy == 'deny'
    assign tracked = true
  endif
  assign rating_count = p.metafields.reviews.rating_count.value | default: 0
  assign root = routes.root_url
  if root == '/'
    assign root = ''
  endif
  assign start_q = 1
  if section.settings.default_pack > 1 and v.available
    assign start_q = section.settings.default_pack
    if tracked and v.inventory_quantity < start_q
      assign start_q = 1
    endif
  endif
  assign cod_note = 'lab.pdp.cod_note' | t | url_encode
  assign cod_attr = 'Contrareembolso' | url_encode
  capture fee_f
    render 'lab-money', v: fee
  endcapture
  assign loc = settings.lab_checkout_locale | strip
  assign qs = '?ref=lab'
  if loc != blank
    assign qs = '?locale=' | append: loc
  endif
  comment
    Código de primer pedido: solo vale con 1 unidad (no se suma a los packs).
    Va puesto en el enlace de compra, así que el precio de 1 unidad se enseña
    ya con él, diciendo de dónde sale.
  endcomment
  assign first_code = ''
  assign first_pct = 0
  if settings.lab_first_auto and settings.lab_first_code != blank and settings.lab_first_pct > 0
    assign first_code = settings.lab_first_code | strip
    assign first_pct = settings.lab_first_pct
  endif
  assign first_code_enc = first_code | url_encode
  comment
    Enlaces como texto: una sección que acepta bloques de apps no puede llevar
    selectores de página.
  endcomment
  assign ret_url = section.settings.ret_link | default: pages['devoluciones'].url
  assign help_url = section.settings.help_link | default: pages['contact'].url
  assign wa = settings.lab_whatsapp | remove: ' ' | remove: '+' | remove: '-' | strip
-%}

{%- if is_fee -%}
  <section class="lab lab-fee">
    <div class="lab-wrap lab-text">
      <p class="lab-eyebrow">{{ 'lab.pdp.fee_eyebrow' | t }}</p>
      <h1 class="lab-h2">{{ 'waistzen_review.fee_title' | t }}</h1>
      <p class="lab-lead">{{ 'waistzen_review.fee_info' | t }}</p>
      <div class="lab-hero__ctas"><a class="lab-btn lab-btn--primary" href="{{ routes.root_url }}">{{ 'lab.crumbs.home' | t }}</a></div>
    </div>
  </section>
{%- else -%}

{%- comment -%} Packs: se calculan antes para poder pintar arriba el precio del pack elegido al entrar. {%- endcomment -%}
{%- capture pills_html -%}
  {%- for q in (1..3) -%}
    {%- liquid
      assign key = 's' | append: q
      assign d = 0
      if q >= 3
        assign d = settings.lab_disc_3
      elsif q >= 2
        assign d = settings.lab_disc_2
      endif
      assign ok = v.available
      if tracked and v.inventory_quantity < q
        assign ok = false
      endif
      assign cut = v.price | times: d | divided_by: 100
      assign unit = v.price | minus: cut
      assign pay = unit | times: q
      assign was = 0
      assign is_first = false
      if q == 1 and first_code != blank
        assign first_cut = v.price | times: first_pct | divided_by: 100
        assign pay = v.price | minus: first_cut
        assign unit = pay
        assign d = first_pct
        assign is_first = true
      endif
      if settings.lab_show_compare and v.compare_at_price > v.price
        assign was = v.compare_at_price | times: q
      elsif d > 0
        assign was = v.price | times: q
      endif
      assign save = 0
      if was > pay
        assign save = was | minus: pay
      endif
      if q == 1
        assign label = 'lab.hero.one' | t
      else
        assign label = 'lab.hero.many' | t: count: q
      endif
      capture pay_f
        render 'lab-money', v: pay
      endcapture
      capture unit_f
        render 'lab-money', v: unit
      endcapture
      assign was_f = ''
      assign save_f = ''
      if save > 0
        capture was_f
          render 'lab-money', v: was
        endcapture
        capture save_f
          render 'lab-money', v: save
        endcapture
        assign save_f = 'lab.card.save' | t | append: ' ' | append: save_f
      endif
      assign badge = ''
      if d > 0 and save > 0
        assign badge = '−' | append: d | append: ' %'
      endif
      assign cod_c = pay | plus: fee
      capture cod_f
        render 'lab-money', v: cod_c
      endcapture
      assign extra = ''
      if is_first
        assign extra = '&discount=' | append: first_code_enc
      endif
      assign buy = routes.cart_url | append: '/' | append: v.id | append: ':' | append: q | append: qs | append: extra
      assign cod_items = v.id | append: ':' | append: q
      if fee > 0
        assign cod_items = cod_items | append: ',' | append: fee_v.id | append: ':1'
      endif
      assign cod_url = routes.cart_url | append: '/' | append: cod_items | append: qs | append: extra | append: '&attributes%5BPago%20preferido%5D=' | append: cod_attr | append: '&note=' | append: cod_note
      if q == start_q
        assign i_pay = pay
        assign i_pay_f = pay_f
        assign i_was_f = was_f
        assign i_save_f = save_f
        assign i_unit_f = unit_f
        assign i_badge = badge
        assign i_buy = buy
        assign i_cod_url = cod_url
        assign i_cod_f = cod_f
        assign i_cod_c = cod_c
        assign i_label = label
        assign i_first = is_first
      endif
    -%}
    <label class="lab-pill{% if q == start_q %} is-on{% endif %}{% if q == 3 and badge != blank %} lab-best{% endif %}">
      <input type="radio" name="lab-pack" value="{{ q }}"{% if q == start_q %} checked{% endif %}{% unless ok %} disabled{% endunless %}
        data-qty="{{ q }}" data-label="{{ label | escape }}" data-pay="{{ pay_f | strip | escape }}" data-pay-cents="{{ pay }}" data-unit="{{ unit_f | strip | escape }}"
        {% if save > 0 %}data-was="{{ was_f | strip | escape }}" data-save="{{ save_f | strip | escape }}" data-badge="{{ badge | escape }}"{% endif %}
        {% if is_first %}data-first="1"{% endif %}
        data-cod="{{ cod_f | strip | escape }}" data-cod-cents="{{ cod_c }}" data-buy="{{ buy }}" data-cod-url="{{ cod_url }}">
      <span class="lab-pill__dot" aria-hidden="true"></span>
      <span class="lab-pill__main">
        <strong>{{ label }}</strong>
        <span>{% if ok %}{{ section.settings[key] | escape }}{% else %}{{ 'lab.pdp.not_enough' | t }}{% endif %}</span>
        {%- if ok and is_first -%}
          <span class="lab-pill__code">{{ 'lab.pdp.first_code' | t: code: first_code }}</span>
        {%- elsif ok and save > 0 -%}
          <span class="lab-pill__code">{{ save_f | strip }}</span>
        {%- endif -%}
      </span>
      <span class="lab-pill__price">
        <strong>{{ pay_f | strip }}</strong>
        {%- if save > 0 -%}<s><span class="visually-hidden">{{ 'lab.card.was' | t }}</span>{{ was_f | strip }}</s>{%- endif -%}
        {%- if q > 1 -%}<span class="lab-unit">{{ unit_f | strip }}{{ 'lab.card.per_unit' | t }}</span>{%- endif -%}
      </span>
      {%- if badge != blank -%}<span class="lab-pill__tag">{{ badge }}</span>{%- endif -%}
    </label>
  {%- endfor -%}
{%- endcapture -%}

<section class="lab lab-pdp" id="{{ pid }}" data-lab-pdp data-variant="{{ v.id }}" data-lab-gallery-label="{{ 'lab.pdp.gallery' | t }}" data-lab-close-label="{{ 'lab.pdp.close' | t }}">
  <div class="lab-wrap">
    <nav class="lab-pdp__crumbs" aria-label="{{ 'lab.crumbs.label' | t }}">
      <ol class="lab-crumbs">
        <li><a href="{{ routes.root_url }}">{{ 'lab.crumbs.home' | t }}</a></li>
        <li><a href="{{ root }}/#catalogo">{{ 'lab.nav.shop' | t }}</a></li>
        <li aria-current="page">{{ p.title | escape }}</li>
      </ol>
    </nav>

    <div class="lab-pdp__grid">
      <div class="lab-gal">
        <div class="lab-gal__track" tabindex="0" role="region" aria-label="{{ 'lab.pdp.gallery' | t }}">
          {%- for m in p.media -%}
            {%- assign img = m.preview_image -%}
            <div class="lab-gal__slide"{% if img != blank %} data-full="{{ img | image_url: width: 1800 }}"{% endif %} aria-label="{{ 'lab.pdp.view_image' | t: index: forloop.index }}">
              {%- if img != blank -%}
                {%- liquid
                  assign alt = m.alt | default: p.title
                  if forloop.first
                    echo img | image_url: width: 1200, height: 1200, crop: 'center' | image_tag: widths: '400, 600, 800, 1000, 1200', sizes: '(min-width: 1240px) 600px, (min-width: 990px) 50vw, 88vw', loading: 'eager', fetchpriority: 'high', alt: alt, width: 1200, height: 1200
                  else
                    echo img | image_url: width: 1200, height: 1200, crop: 'center' | image_tag: widths: '400, 600, 800, 1000, 1200', sizes: '(min-width: 1240px) 600px, (min-width: 990px) 50vw, 88vw', loading: 'lazy', alt: alt, width: 1200, height: 1200
                  endif
                -%}
              {%- endif -%}
            </div>
          {%- else -%}
            <div class="lab-gal__slide">{{ 'product-1' | placeholder_svg_tag }}</div>
          {%- endfor -%}
        </div>
        {%- if p.media.size > 1 -%}
          <span class="lab-mono lab-gal__count" data-lab-gal-count aria-hidden="true">01 / {% if p.media.size < 10 %}0{% endif %}{{ p.media.size }}</span>
          <div class="lab-gal__thumbs">
            {%- for m in p.media -%}
              <button type="button" aria-current="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="{{ 'lab.pdp.view_image' | t: index: forloop.index }}">
                {{ m.preview_image | image_url: width: 140, height: 140, crop: 'center' | image_tag: width: 64, height: 64, loading: 'lazy', alt: '' }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="lab-pdp__info">
        <div>
          {%- if section.settings.eyebrow != blank -%}<p class="lab-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
          <h1 class="lab-pdp__title">{{ p.title | escape }}{% if section.settings.subtitle != blank %}<span>{{ section.settings.subtitle | escape }}</span>{% endif %}</h1>
        </div>

        {%- if rating_count > 0 -%}
          {%- assign r = p.metafields.reviews.rating.value.rating | round: 1 -%}
          <a class="lab-rating" href="#opiniones">{% render 'lab-icon', name: 'star' %}<strong>{{ r | replace: '.', ',' }}</strong><span>({{ 'lab.pdp.reviews' | t: count: rating_count }})</span></a>
        {%- endif -%}

        <div class="lab-pdp__price" id="packs">
          <div class="lab-price">
            <span class="lab-price__now lab-roll{% if i_was_f != blank %} is-sale{% endif %}" data-lab-now data-cents="{{ i_pay }}">{{ i_pay_f | strip }}</span>
            <s class="lab-price__was" data-lab-was{% if i_was_f == blank %} hidden{% endif %}>{{ i_was_f | strip }}</s>
            <span class="lab-price__badge" data-lab-badge{% if i_badge == blank %} hidden{% endif %}>{{ i_badge }}</span>
          </div>
          <span class="lab-unit" data-lab-unitline{% if start_q == 1 %} hidden{% endif %}><span data-lab-unit>{{ i_unit_f | strip }}</span>{{ 'lab.card.per_unit' | t }} · <span class="lab-save" data-lab-save>{{ i_save_f | strip }}</span></span>
          {%- if first_code != blank -%}
            <p class="lab-first" data-lab-first{% unless i_first %} hidden{% endunless %}>{{ 'lab.pdp.first_note_html' | t: pct: first_pct, code: first_code }}</p>
          {%- endif -%}
          {%- if settings.lab_disc_3 > 0 and v.available -%}
            {%- capture u3 -%}{% render 'lab-pack-price', price: v.price, qty: 3, show: 'unit' %}{%- endcapture -%}
            <button type="button" class="lab-teaser" data-lab-pick="3"{% if start_q != 1 %} hidden{% endif %}>{{ 'lab.pdp.teaser' | t: unit: u3 }}</button>
          {%- endif -%}
          <p class="lab-note">{{ 'lab.pdp.tax_note' | t }}{% if section.settings.ship_note != blank %} {{ section.settings.ship_note | escape }}{% endif %}</p>
        </div>

        {%- if v.available -%}
          <p class="lab-stock">{% if tracked and v.inventory_quantity <= section.settings.low_stock %}{{ 'lab.pdp.low_stock' | t: count: v.inventory_quantity }}{% else %}{{ 'lab.pdp.in_stock' | t }}{% endif %}</p>
        {%- else -%}
          <p class="lab-stock is-out">{{ 'lab.card.sold_out' | t }}</p>
        {%- endif -%}

        <fieldset class="lab-pills">
          <legend>{{ 'lab.pdp.choose' | t }}</legend>
          {{ pills_html }}
        </fieldset>

        <div class="lab-pdp__actions" data-lab-actions>
          {%- if v.available -%}
            <a class="lab-btn lab-btn--accent lab-btn--block lab-btn--xl" data-lab-buy data-variant="{{ v.id }}" data-qty="{{ start_q }}" href="{{ i_buy }}"><span>{{ 'lab.pdp.buy_now' | t }}</span><span aria-hidden="true">·</span><span class="lab-roll" data-lab-now data-cents="{{ i_pay }}">{{ i_pay_f | strip }}</span></a>
            {%- if section.settings.cod -%}
              {%- if fee > 0 -%}
                <button type="button" class="lab-btn lab-btn--ghost lab-btn--block" data-lab-cod-open aria-expanded="false" aria-controls="{{ pid }}-cod">{% render 'lab-icon', name: 'cash' %}{{ 'lab.pdp.cod_open' | t: fee: fee_f }}</button>
              {%- else -%}
                <a class="lab-btn lab-btn--ghost lab-btn--block" data-lab-cod-go data-variant="{{ v.id }}" data-qty="{{ start_q }}" href="{{ i_cod_url }}">{% render 'lab-icon', name: 'cash' %}{{ 'lab.pdp.cod_btn' | t }}</a>
              {%- endif -%}
            {%- endif -%}
            {%- liquid
              assign pay_note = section.settings.pay_note
              if section.settings.cod and fee > 0
                assign pay_note = section.settings.pay_note_fee
              elsif section.settings.cod == false
                assign pay_note = section.settings.pay_note_nocod
              endif
            -%}
            {%- if pay_note != blank -%}<p class="lab-paynote">{% render 'lab-fill', text: pay_note, product: p %}</p>{%- endif -%}
          {%- endif -%}
          {%- assign fid = pid | append: '-form' -%}
          {%- capture add_lbl -%}{{ 'lab.pdp.add_link' | t }}{%- endcapture -%}
          {% render 'lab-atc', product: p, variant: v, qty: start_q, form_id: fid, label: add_lbl, btn: 'lab-btn--text', qty_input: true %}
        </div>

        {%- if fee > 0 and v.available -%}
          <div class="lab-cod" id="{{ pid }}-cod" data-lab-cod hidden>
            <div class="lab-cod__row"><span>{{ 'lab.pdp.cod_pack' | t }}</span><span data-lab-cod-sub>{{ i_pay_f | strip }}</span></div>
            <div class="lab-cod__row"><span>{{ 'lab.pdp.cod_fee' | t }}</span><span>{{ fee_f | strip }}</span></div>
            <div class="lab-cod__row"><strong>{{ 'lab.pdp.cod_total' | t }}</strong><strong class="lab-roll" data-lab-cod-total data-cents="{{ i_cod_c }}">{{ i_cod_f | strip }}</strong></div>
            <p>{{ 'lab.pdp.cod_help' | t }}</p>
            <a class="lab-btn lab-btn--primary lab-btn--block" data-lab-cod-go data-variant="{{ v.id }}" data-qty="{{ start_q }}" href="{{ i_cod_url }}">{{ 'lab.pdp.cod_go' | t }}{% render 'lab-icon', name: 'arrow' %}</a>
          </div>
        {%- endif -%}

        <ul class="lab-assure" role="list">
          <li>
            {% render 'lab-icon', name: 'truck' %}
            <span><strong>{% render 'lab-eta' %}</strong>{% if section.settings.g_ship != blank %}<small>{{ section.settings.g_ship | escape }}</small>{% endif %}</span>
          </li>
          {%- if section.settings.g_ret != blank -%}
            <li>
              {% render 'lab-icon', name: 'refresh' %}
              <span><strong>{{ section.settings.g_ret | escape }}</strong><small>{{ section.settings.g_ret_sub | escape }}{% if ret_url != blank %} <a href="{{ ret_url }}">{{ 'lab.pdp.terms' | t }}</a>{% endif %}</small></span>
            </li>
          {%- endif -%}
          {%- if section.settings.g_war != blank -%}
            <li>
              {% render 'lab-icon', name: 'shield' %}
              <span><strong>{{ section.settings.g_war | escape }}</strong>{% if section.settings.g_war_sub != blank %}<small>{{ section.settings.g_war_sub | escape }}</small>{% endif %}</span>
            </li>
          {%- endif -%}
          {%- if section.settings.g_help != blank -%}
            <li>
              {% render 'lab-icon', name: 'chat' %}
              <span><strong>{{ section.settings.g_help | escape }}</strong>
                <small>
                  {%- if section.settings.g_help_sub != blank -%}{{ section.settings.g_help_sub | escape }} {% endif -%}
                  {%- if wa != blank -%}<a href="https://wa.me/{{ wa }}" target="_blank" rel="noopener" data-lab-wa>{{ 'lab.pdp.whatsapp' | t }}</a>{% if help_url != blank %} · {% endif %}{%- endif -%}
                  {%- if help_url != blank -%}<a href="{{ help_url }}">{{ 'lab.pdp.write_us' | t }}</a>{%- endif -%}
                </small>
              </span>
            </li>
          {%- endif -%}
        </ul>

        {%- if shop.enabled_payment_types.size > 0 -%}
          <ul class="lab-pay" aria-label="{{ 'lab.footer.pay' | t }}">
            {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag }}</li>{%- endfor -%}
            {%- if section.settings.cod -%}<li class="lab-pay__cod">{% render 'lab-icon', name: 'cash' %}{{ 'lab.pdp.cod_chip' | t }}</li>{%- endif -%}
          </ul>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <div class="lab-acc">
            {%- for b in section.blocks -%}
              {%- case b.type -%}
                {%- when '@app' -%}
                  {% render b %}
                {%- when 'description' -%}
                  {%- if p.description != blank -%}
                    <details {{ b.shopify_attributes }}{% if b.settings.open %} open{% endif %}>
                      <summary>{{ b.settings.title | escape }}{% render 'lab-icon', name: 'plus' %}</summary>
                      <div class="lab-acc__c">{{ p.description }}</div>
                    </details>
                  {%- endif -%}
                {%- else -%}
                  <details {{ b.shopify_attributes }}{% if b.settings.open %} open{% endif %}>
                    <summary>{{ b.settings.title | escape }}{% render 'lab-icon', name: 'plus' %}</summary>
                    <div class="lab-acc__c">{% render 'lab-fill', text: b.settings.text, product: p %}</div>
                  </details>
              {%- endcase -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{%- if v.available -%}
  <div class="lab lab-sticky" data-lab-sticky="{{ pid }}" inert>
    <div class="lab-sticky__txt"><span data-lab-sticky-label>{{ i_label }}</span><strong class="lab-roll" data-lab-now data-cents="{{ i_pay }}">{{ i_pay_f | strip }}</strong></div>
    <a class="lab-btn lab-btn--accent" data-lab-buy data-lab-place="barra" data-variant="{{ v.id }}" data-qty="{{ start_q }}" href="{{ i_buy }}">{{ 'lab.pdp.buy_now' | t }}</a>
  </div>
{%- endif -%}

<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- comment -%} Datos estructurados: precio de la unidad sin códigos y solo el primer párrafo de la descripción. {%- endcomment -%}
{%- assign ld_desc = p.description | split: '</p>' | first | strip_html | strip_newlines | strip | truncate: 300 -%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Product",
        "@id": {{ request.origin | append: p.url | append: '#product' | json }},
        "name": {{ p.title | json }},
        "url": {{ request.origin | append: p.url | json }},
        "description": {{ ld_desc | json }},
        {%- if v.sku != blank %}"sku": {{ v.sku | json }},{% endif %}
        {%- if v.barcode != blank %}"gtin": {{ v.barcode | json }},{% endif %}
        {%- if section.settings.brand != blank %}"brand": {"@type": "Brand", "name": {{ section.settings.brand | json }}},{% endif %}
        "image": [{% for m in p.media limit: 6 %}{{ m.preview_image | image_url: width: 1200 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}{% endfor %}],
        {%- if rating_count > 0 %}
        "aggregateRating": {"@type": "AggregateRating", "ratingValue": {{ p.metafields.reviews.rating.value.rating | json }}, "reviewCount": {{ rating_count }}},
        {%- endif %}
        "offers": {
          "@type": "Offer",
          "url": {{ request.origin | append: p.url | json }},
          "price": {{ v.price | divided_by: 100.0 | round: 2 | json }},
          "priceCurrency": {{ cart.currency.iso_code | json }},
          "availability": "https://schema.org/{% if v.available %}InStock{% else %}OutOfStock{% endif %}",
          "itemCondition": "https://schema.org/NewCondition",
          "seller": {"@type": "Organization", "name": {{ shop.name | json }}}
          {%- if section.settings.free_shipping %},
          "shippingDetails": {
            "@type": "OfferShippingDetails",
            "shippingRate": {"@type": "MonetaryAmount", "value": 0, "currency": {{ cart.currency.iso_code | json }}},
            "shippingDestination": {"@type": "DefinedRegion", "addressCountry": "ES"},
            "deliveryTime": {
              "@type": "ShippingDeliveryTime",
              "handlingTime": {"@type": "QuantitativeValue", "minValue": 0, "maxValue": 1, "unitCode": "DAY"},
              "transitTime": {"@type": "QuantitativeValue", "minValue": 1, "maxValue": 2, "unitCode": "DAY"}
            }
          }
          {%- endif %}
          {%- if section.settings.return_days > 0 %},
          "hasMerchantReturnPolicy": {
            "@type": "MerchantReturnPolicy",
            "applicableCountry": "ES",
            "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
            "merchantReturnDays": {{ section.settings.return_days }},
            "returnMethod": "https://schema.org/ReturnByMail",
            "returnFees": "https://schema.org/FreeReturn"
          }
          {%- endif %}
        }
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {"@type": "ListItem", "position": 1, "name": {{ 'lab.crumbs.home' | t | json }}, "item": {{ request.origin | append: routes.root_url | json }}},
          {"@type": "ListItem", "position": 2, "name": {{ p.title | json }}, "item": {{ request.origin | append: p.url | json }}}
        ]
      }
    ]
  }
</script>
{%- endif -%}

