{%- liquid
  assign featured = section.settings.product
  assign variant = featured.selected_or_first_available_variant
  assign poster_url = 'reliefpath-cinema-poster-20261011.jpg' | asset_url
  if section.settings.poster != blank
    assign poster_url = section.settings.poster | image_url: width: 1080
  endif
-%}
<section class="rp-cinema{% if section.settings.page_title %} rp-cinema--hero{% endif %}" data-rp-cinema aria-labelledby="rp-cinema-title-{{ section.id }}">
  <div class="rp-wrap">
    <div class="rp-cinema__grid">
      <div class="rp-cinema__copy">
        <p class="rp-cinema__eyebrow"><span aria-hidden="true"></span>{{ section.settings.eyebrow | escape }}</p>
        {% if section.settings.page_title %}<h1 id="rp-cinema-title-{{ section.id }}" class="rp-cinema__title">{{ section.settings.heading | escape }}<em>{{ section.settings.accent | escape }}</em></h1>{% else %}<h2 id="rp-cinema-title-{{ section.id }}" class="rp-cinema__title">{{ section.settings.heading | escape }}<em>{{ section.settings.accent | escape }}</em></h2>{% endif %}
        <p class="rp-cinema__text">{{ section.settings.text | escape }}</p>
      </div>
      <div class="rp-cinema__stage">
        <rp-cinema-media class="rp-cinema__media" data-autoplay="{{ section.settings.autoplay }}">
          <img class="rp-cinema__poster" src="{{ poster_url }}" width="1080" height="1080" alt="{{ 'rp.cinema.image_alt' | t | escape }}" loading="{% if section.settings.page_title %}eager{% else %}lazy{% endif %}"{% if section.settings.page_title %} fetchpriority="high"{% endif %}>
          {% if section.settings.video_url != blank %}
          <video class="rp-cinema__video" data-src="{{ section.settings.video_url | escape }}" muted playsinline loop preload="none" aria-hidden="true" tabindex="-1"></video>
          <button class="rp-cinema__motion" type="button" data-cinema-motion data-play="{{ 'rp.cinema.play' | t | escape }}" data-pause="{{ 'rp.cinema.pause' | t | escape }}" hidden>
            <svg class="rp-cinema__play" viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="m6 4 10 6-10 6Z" fill="currentColor"/></svg>
            <svg class="rp-cinema__pause" viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="M6 4v12M14 4v12" fill="none" stroke="currentColor" stroke-width="3"/></svg>
            <span data-cinema-label>{{ 'rp.cinema.play' | t }}</span>
          </button>
          {% endif %}
        </rp-cinema-media>
        <div class="rp-cinema__caption"><span>{{ 'rp.cinema.caption' | t }}</span><a href="#funciones">{{ 'rp.cinema.real_product' | t }}<span class="rp-arrow" aria-hidden="true">{% render 'sr-icon', name: 'arrow' %}</span></a></div>
        {% if section.settings.video_url != blank %}<noscript><a class="rp-cinema__fallback" href="{{ section.settings.video_url | escape }}">{{ 'rp.cinema.open_video' | t }}</a></noscript>{% endif %}
      </div>
      <div class="rp-cinema__offer">
        {% if featured != blank and section.settings.show_price %}
        <div class="rp-cinema__price" data-cinema-price><strong>{{ variant.price | money }}</strong>{% if variant.compare_at_price > variant.price %}<s>{{ variant.compare_at_price | money }}</s><span>{{ 'rp.cro.save' | t }} {{ variant.compare_at_price | minus: variant.price | money }}</span>{% endif %}</div>
        <p class="rp-cinema__payment">{{ 'rp.hero.one_payment' | t }}</p>
        {% render 'rp-stock-note', variant: variant, threshold: section.settings.stock_threshold %}
        {% endif %}
        <a class="rp-cinema__buy" href="#comprar" data-cinema-buy>{{ section.settings.cta | escape }}<span class="rp-arrow" aria-hidden="true">{% render 'sr-icon', name: 'arrow' %}</span></a>
        <p class="rp-cinema__reassurance">{{ 'rp.cro.hero_reassurance' | t }}</p>
      </div>
    </div>
    <div class="rp-cinema__meta"><span>{% render 'sr-icon', name: 'truck' %}{{ 'rp.hero.shipping' | t }}</span><span>{% render 'sr-icon', name: 'lock' %}{{ 'rp.hero.payment' | t }}</span><span>{% render 'sr-icon', name: 'refresh' %}{{ 'rp.hero.returns' | t }}</span></div>
  </div>
</section>

{% stylesheet %}
body.rp-studio .rp-cinema{--cinema-ink:#f4f0e6;--cinema-gold:#d5b888;position:relative;overflow:hidden;background:#101714;color:var(--cinema-ink)}
body.rp-studio .rp-cinema::before{content:"";position:absolute;inset:0;pointer-events:none;background:radial-gradient(ellipse at 7% 26%,rgba(108,127,97,.09),transparent 54%)}
body.rp-studio .rp-cinema>.rp-wrap{position:relative}
body.rp-studio .rp-cinema__grid{display:grid;grid-template-columns:1fr 1fr;grid-template-areas:"copy stage" "offer stage";gap:0 48px;align-items:center;padding:52px 0 38px}
body.rp-studio .rp-cinema__copy{grid-area:copy;align-self:end;padding-bottom:28px}
body.rp-studio .rp-cinema__eyebrow{display:flex;gap:10px;align-items:center;margin:0 0 23px;color:var(--cinema-gold);font-size:12px;font-weight:600;letter-spacing:.09em;line-height:1.6}
body.rp-studio .rp-cinema__eyebrow>span{width:6px;height:6px;border-radius:50%;flex:none;background:var(--cinema-gold);box-shadow:0 0 12px rgba(213,184,136,.45)}
body.rp-studio .rp-cinema__title{margin:0;color:var(--cinema-ink);font-family:var(--rp-font);font-weight:600;font-size:clamp(46px,5.2vw,76px);line-height:1.04;letter-spacing:-.055em}
body.rp-studio .rp-cinema__title em{display:block;margin-top:7px;color:var(--cinema-gold);font-family:'Fraunces',Georgia,'Times New Roman',serif;font-weight:400;letter-spacing:-.045em}
body.rp-studio .rp-cinema__text{max-width:420px;margin:23px 0 0;color:#bac4b9;font-size:15px;line-height:1.75}
body.rp-studio .rp-cinema__stage{grid-area:stage;min-width:0}
body.rp-studio .rp-cinema__media{position:relative;display:block;aspect-ratio:1;background:#101714;isolation:isolate}
body.rp-studio .rp-cinema__poster,body.rp-studio .rp-cinema__video{display:block;width:100%;height:100%;object-fit:contain}
body.rp-studio .rp-cinema__video{position:absolute;inset:0;opacity:0;transition:opacity .25s;pointer-events:none}
body.rp-studio .rp-cinema__media.has-frame:not(.is-failed) .rp-cinema__video{opacity:1}
body.rp-studio .rp-cinema__motion{position:absolute;right:14px;bottom:14px;z-index:2;display:flex;gap:8px;align-items:center;justify-content:center;min-height:44px;padding:10px 13px;border:1px solid #756a54;border-radius:4px;background:rgba(16,23,20,.94);color:#f4f0e6;font:500 12px/1.4 var(--rp-font);cursor:pointer}
body.rp-studio .rp-cinema__motion[hidden]{display:none}
body.rp-studio .rp-cinema__pause{display:none}
body.rp-studio .rp-cinema__media.is-playing .rp-cinema__play{display:none}
body.rp-studio .rp-cinema__media.is-playing .rp-cinema__pause{display:block}
body.rp-studio .rp-cinema__caption{display:flex;flex-wrap:wrap;gap:4px 15px;align-items:center;justify-content:space-between;margin-top:3px;color:#bac4b9;font-size:12px;line-height:1.6}
body.rp-studio .rp-cinema__caption>a,body.rp-studio .rp-cinema__fallback{display:inline-flex;gap:7px;align-items:center;min-height:44px;color:var(--cinema-gold);text-decoration:underline;text-underline-offset:4px;font-size:12px}
body.rp-studio .rp-cinema__caption .rp-arrow svg{width:15px;height:15px}
body.rp-studio .rp-cinema__offer{grid-area:offer;align-self:start;max-width:420px}
body.rp-studio .rp-cinema__price{display:flex;flex-wrap:wrap;gap:8px 12px;align-items:center;font-variant-numeric:tabular-nums}
body.rp-studio .rp-cinema__price>strong{font-size:32px;line-height:1.2;font-weight:650;letter-spacing:-.04em;color:var(--cinema-ink)}
body.rp-studio .rp-cinema__price>s{color:#b5bbae;font-size:14px}
body.rp-studio .rp-cinema__price>span{border:1px solid #74684e;border-radius:3px;padding:4px 7px;color:var(--cinema-gold);font-size:12px;font-weight:600;line-height:1.4}
body.rp-studio .rp-cinema__payment{margin:9px 0 0;color:#bac4b9;font-size:12px;line-height:1.5}
body.rp-studio .rp-cinema .rp-urgency{margin-top:10px;color:#e0c998;font-size:12px;line-height:1.5}
body.rp-studio .rp-cinema .rp-urgency>i{background:#d5b888}
body.rp-studio .rp-cinema__buy{display:flex;justify-content:space-between;align-items:center;gap:16px;width:100%;min-height:56px;margin-top:18px;padding:16px 21px;border:1px solid #e4c995;border-radius:4px;background:#d5b888;color:#101714;font:600 14px/1.4 var(--rp-font);text-decoration:none;transition:background .2s,box-shadow .2s}
body.rp-studio .rp-cinema__buy:hover{background:#e6cda5;box-shadow:0 0 28px rgba(213,184,136,.12)}
body.rp-studio .rp-cinema__reassurance{max-width:390px;margin:11px 0 0;color:#bac4b9;font-size:12px;line-height:1.65}
body.rp-studio .rp-cinema__meta{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;padding:21px 0 24px;border-top:1px solid #394238;color:#bac4b9}
body.rp-studio .rp-cinema__meta>span{display:flex;gap:10px;align-items:center;font-size:12px;line-height:1.6}
body.rp-studio .rp-cinema__meta>span+span{border-left:1px solid #394238;padding-left:22px}
body.rp-studio .rp-cinema__meta svg{width:18px;height:18px;flex:none;color:var(--cinema-gold)}
body.rp-studio .rp-cinema a:focus-visible,body.rp-studio .rp-cinema button:focus-visible{outline:2px solid #f4f0e6;outline-offset:4px}
body.rp-studio:has(.rp-cinema--hero) .rp-header{background:#101714;border-bottom-color:#394238;color:#f4f0e6}
body.rp-studio:has(.rp-cinema--hero) .rp-header .rp-brand,body.rp-studio:has(.rp-cinema--hero) .rp-header__nav>a,body.rp-studio:has(.rp-cinema--hero) .rp-header__cart,body.rp-studio:has(.rp-cinema--hero) .rp-mobile-nav>summary{color:#f4f0e6}
body.rp-studio:has(.rp-cinema--hero) .rp-header__shop{background:#d5b888;border-color:#d5b888;color:#101714}
body.rp-studio:has(.rp-cinema--hero) .rp-mobile-nav>nav{background:#17211c;border-color:#394238}
body.rp-studio:has(.rp-cinema--hero) .rp-mobile-nav>nav>a{color:#f4f0e6}
body.rp-studio:has(.rp-cinema--hero) .rp-header a:focus-visible,body.rp-studio:has(.rp-cinema--hero) .rp-header summary:focus-visible{outline-color:#f4f0e6}
@media(max-width:989px){body.rp-studio .rp-cinema__grid{gap:0 24px;padding-top:36px}body.rp-studio .rp-cinema__title{font-size:49px}body.rp-studio .rp-cinema__eyebrow{margin-bottom:17px;font-size:12px}body.rp-studio .rp-cinema__text{font-size:14px;margin-top:17px}}
@media(max-width:749px){body.rp-studio .rp-cinema__grid{grid-template-columns:minmax(0,1fr);grid-template-areas:"copy" "stage" "offer";gap:0;padding:25px 0 23px}body.rp-studio .rp-cinema__copy{padding-bottom:7px}body.rp-studio .rp-cinema__eyebrow{margin-bottom:13px;font-size:12px;line-height:1.4;letter-spacing:.065em}body.rp-studio .rp-cinema__title{font-size:38px;line-height:1.06}body.rp-studio .rp-cinema__title em{margin-top:3px}body.rp-studio .rp-cinema__text{margin-top:13px;max-width:430px;font-size:13px;line-height:1.65}body.rp-studio .rp-cinema__media{width:100%;height:244px;aspect-ratio:auto}body.rp-studio .rp-cinema__motion{bottom:9px;right:0}body.rp-studio .rp-cinema__caption{margin-top:0;font-size:12px;gap:0 12px}body.rp-studio .rp-cinema__caption>a{min-height:44px}body.rp-studio .rp-cinema__offer{max-width:none;margin-top:7px}body.rp-studio .rp-cinema__price{gap:7px 10px}body.rp-studio .rp-cinema__price>strong{font-size:29px}body.rp-studio .rp-cinema__price>span{padding:4px 6px}body.rp-studio .rp-cinema__payment{margin-top:7px}body.rp-studio .rp-cinema .rp-urgency{margin-top:7px}body.rp-studio .rp-cinema__buy{margin-top:13px;min-height:54px;padding:14px 16px}body.rp-studio .rp-cinema__reassurance{margin-top:9px}body.rp-studio .rp-cinema__meta{gap:10px;padding:17px 0 21px}body.rp-studio .rp-cinema__meta>span{flex-direction:column;align-items:flex-start;gap:6px;font-size:12px;line-height:1.5}body.rp-studio .rp-cinema__meta>span+span{padding-left:11px}}
@media(max-width:374px){body.rp-studio .rp-cinema__title{font-size:34px}body.rp-studio .rp-cinema__media{height:218px}body.rp-studio .rp-cinema__eyebrow{letter-spacing:.025em}body.rp-studio .rp-cinema__grid{padding-top:22px}}
@media(max-width:749px){body.rp-studio .rp-cinema__motion{width:44px;min-width:44px;padding:10px;border-radius:50%}body.rp-studio .rp-cinema__motion [data-cinema-label]{position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}}
@media(prefers-reduced-motion:reduce){body.rp-studio .rp-cinema__video,body.rp-studio .rp-cinema__buy{transition:none}body.rp-studio .rp-cinema{scroll-behavior:auto}}
{% endstylesheet %}

{% javascript %}
if (!customElements.get('rp-cinema-media')) {
  customElements.define('rp-cinema-media', class extends HTMLElement {
    connectedCallback() {
      if (this.controller) return;
      this.video = this.querySelector('video');
      this.button = this.querySelector('[data-cinema-motion]');
      if (!this.video || !this.button) return;
      this.controller = new AbortController();
      const options = {signal: this.controller.signal};
      this.reduce = matchMedia('(prefers-reduced-motion: reduce)');
      this.inView = false;
      this.userPaused = false;
      this.userOptIn = false;
      this.failed = false;
      this.video.muted = true;
      this.button.hidden = false;
      this.updateLabel();
      this.button.addEventListener('click', () => {
        if (!this.video.paused) {
          this.userPaused = true;
          this.video.pause();
        } else {
          this.userPaused = false;
          this.userOptIn = true;
          this.syncPlayback();
        }
      }, options);
      this.video.addEventListener('play', () => {
        if (!this.eligible()) this.video.pause();
        this.updateLabel();
      }, options);
      this.video.addEventListener('pause', () => this.updateLabel(), options);
      this.video.addEventListener('loadeddata', () => this.classList.add('has-frame'), options);
      this.video.addEventListener('error', () => {
        this.failed = true;
        this.classList.add('is-failed');
        this.video.pause();
        this.button.hidden = true;
      }, options);
      document.addEventListener('visibilitychange', () => this.syncPlayback(), options);
      this.reduce.addEventListener('change', () => {
        this.userOptIn = false;
        this.syncPlayback();
      }, options);
      if ('IntersectionObserver' in window) {
        this.observer = new IntersectionObserver((entries) => {
          this.inView = entries[0].isIntersecting && entries[0].intersectionRatio >= 0.25;
          this.syncPlayback();
        }, {threshold: [0, 0.25]});
        this.observer.observe(this);
      } else {
        this.inView = true;
        this.syncPlayback();
      }
    }
    eligible() {
      const automatic = this.dataset.autoplay === 'true' && !this.reduce.matches && !(navigator.connection && navigator.connection.saveData) && !(window.Shopify && Shopify.designMode);
      return this.inView && !document.hidden && !this.userPaused && !this.failed && (this.userOptIn || automatic);
    }
    syncPlayback() {
      if (!this.eligible()) {
        this.video.pause();
        this.updateLabel();
        return;
      }
      if (!this.video.getAttribute('src')) this.video.src = this.video.dataset.src;
      const result = this.video.play();
      if (result && result.catch) result.catch(() => {
        if (this.inView && !document.hidden) this.userPaused = true;
        this.updateLabel();
      });
    }
    updateLabel() {
      const playing = !this.video.paused && !this.failed;
      this.classList.toggle('is-playing', playing);
      this.button.querySelector('[data-cinema-label]').textContent = playing ? this.button.dataset.pause : this.button.dataset.play;
    }
    disconnectedCallback() {
      if (this.video) this.video.pause();
      if (this.controller) this.controller.abort();
      if (this.observer) this.observer.disconnect();
      this.controller = null;
    }
  });
}
{% endjavascript %}

{% schema %}
{
  "name": "RP · Portada 3D",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Producto"
    },
    {
      "type": "checkbox",
      "id": "page_title",
      "label": "Usar como portada principal",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "default": "RELIEFPATH · VENTOSA ELÉCTRICA 3 EN 1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Tu pausa."
    },
    {
      "type": "text",
      "id": "accent",
      "label": "Énfasis",
      "default": "Otra dimensión."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Descripción",
      "default": "Succión regulable, calor y luz roja. Tres funciones en una pausa para ti."
    },
    {
      "type": "url",
      "id": "video_url",
      "label": "Vídeo 3D MP4"
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Portada del vídeo personalizada"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Reproducir sin sonido al estar visible",
      "default": true
    },
    {
      "type": "text",
      "id": "cta",
      "label": "Botón de compra",
      "default": "Elegir mi pack"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Mostrar precio de una unidad",
      "default": true
    },
    {
      "type": "range",
      "id": "stock_threshold",
      "label": "Avisar de stock limitado desde",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "ud",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "RP · Portada 3D"
    }
  ]
}
{% endschema %}
