<div></div>
{% schema %}
{
  "name": "Sonda i3",
  "settings": [
    {
      "type": "header",
      "content": "Garantías junto al botón"
    },
    {
      "type": "text",
      "id": "g_ship",
      "label": "Entrega · detalle",
      "info": "La fecha se calcula sola (Ajustes del tema › Entrega estimada).",
      "default": "Envío gratis desde España. Estimación para península."
    },
    {
      "type": "text",
      "id": "g_ret",
      "label": "Devolución",
      "default": "30 días para devolverlo"
    },
    {
      "type": "text",
      "id": "g_ret_sub",
      "label": "Devolución · detalle",
      "default": "La etiqueta de vuelta la pagamos nosotros."
    },
    {
      "type": "page",
      "id": "ret_page",
      "label": "Devolución · página",
      "info": "Vacío: la página «devoluciones»."
    },
    {
      "type": "text",
      "id": "g_war",
      "label": "Garantía",
      "default": "3 años de garantía legal"
    },
    {
      "type": "text",
      "id": "g_war_sub",
      "label": "Garantía · detalle",
      "default": "Si falla, se repara o se cambia."
    },
    {
      "type": "text",
      "id": "g_help",
      "label": "Ayuda",
      "default": "¿Dudas antes de comprar?"
    },
    {
      "type": "text",
      "id": "g_help_sub",
      "label": "Ayuda · detalle",
      "default": "Te respondemos en español."
    },
    {
      "type": "page",
      "id": "help_page",
      "label": "Ayuda · página",
      "info": "Vacío: la página «contact». El WhatsApp se pone en Ajustes del tema."
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "description",
      "name": "Descripción",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Descripción"
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "Abierto",
          "default": false
        }
      ]
    },
    {
      "type": "tab",
      "name": "Pestaña",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Modo de uso"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Texto",
          "info": "Admite las marcas [p1] [p2] [p3] [u2] [u3] [cod] [fee].",
          "default": "<p>Escribe aquí el contenido.</p>"
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "Abierto",
          "default": false
        }
      ]
    }
  ]
}
{% endschema %}
