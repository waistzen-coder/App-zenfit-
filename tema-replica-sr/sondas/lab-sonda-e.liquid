<section class="lab lab-pdp" id="{{ pid }}" data-lab-pdp data-variant="{{ v.id }}" data-lab-gallery-label="{{ 'lab.pdp.gallery' | t }}" data-lab-close-label="{{ 'lab.pdp.close' | t }}">
  <div class="lab-wrap">
    <nav class="lab-pdp__crumbs" aria-label="{{ 'lab.crumbs.label' | t }}">
      <ol class="lab-crumbs">
        <li><a href="{{ routes.root_url }}">{{ 'lab.crumbs.home' | t }}</a></li>
        <li><a href="{{ root }}/#catalogo">{{ 'lab.nav.shop' | t }}</a></li>
        <li aria-current="page">{{ p.title | escape }}</li>
      </ol>
    </nav>

    <div class="lab-pdp__grid">
      <div class="lab-gal">
        <div class="lab-gal__track" tabindex="0" role="region" aria-label="{{ 'lab.pdp.gallery' | t }}">
          {%- for m in p.media -%}
            {%- assign img = m.preview_image -%}
            <div class="lab-gal__slide"{% if img != blank %} data-full="{{ img | image_url: width: 1800 }}"{% endif %} aria-label="{{ 'lab.pdp.view_image' | t: index: forloop.index }}">
              {%- if img != blank -%}
                {%- liquid
                  assign alt = m.alt | default: p.title
                  if forloop.first
                    echo img | image_url: width: 1200, height: 1200, crop: 'center' | image_tag: widths: '400, 600, 800, 1000, 1200', sizes: '(min-width: 1240px) 600px, (min-width: 990px) 50vw, 88vw', loading: 'eager', fetchpriority: 'high', alt: alt, width: 1200, height: 1200
                  else
                    echo img | image_url: width: 1200, height: 1200, crop: 'center' | image_tag: widths: '400, 600, 800, 1000, 1200', sizes: '(min-width: 1240px) 600px, (min-width: 990px) 50vw, 88vw', loading: 'lazy', alt: alt, width: 1200, height: 1200
                  endif
                -%}
              {%- endif -%}
            </div>
          {%- else -%}
            <div class="lab-gal__slide">{{ 'product-1' | placeholder_svg_tag }}</div>
          {%- endfor -%}
        </div>
        {%- if p.media.size > 1 -%}
          <span class="lab-mono lab-gal__count" data-lab-gal-count aria-hidden="true">01 / {% if p.media.size < 10 %}0{% endif %}{{ p.media.size }}</span>
          <div class="lab-gal__thumbs">
            {%- for m in p.media -%}
              <button type="button" aria-current="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="{{ 'lab.pdp.view_image' | t: index: forloop.index }}">
                {{ m.preview_image | image_url: width: 140, height: 140, crop: 'center' | image_tag: width: 64, height: 64, loading: 'lazy', alt: '' }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="lab-pdp__info">
        <div>
          {%- if section.settings.eyebrow != blank -%}<p class="lab-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
          <h1 class="lab-pdp__title">{{ p.title | escape }}{% if section.settings.subtitle != blank %}<span>{{ section.settings.subtitle | escape }}</span>{% endif %}</h1>
        </div>

        {%- if rating_count > 0 -%}
          {%- assign r = p.metafields.reviews.rating.value.rating | round: 1 -%}
          <a class="lab-rating" href="#opiniones">{% render 'lab-icon', name: 'star' %}<strong>{{ r | replace: '.', ',' }}</strong><span>({{ 'lab.pdp.reviews' | t: count: rating_count }})</span></a>
        {%- endif -%}

        <div class="lab-pdp__price" id="packs">
          <div class="lab-price">
            <span class="lab-price__now lab-roll{% if i_was_f != blank %} is-sale{% endif %}" data-lab-now data-cents="{{ i_pay }}">{{ i_pay_f | strip }}</span>
            <s class="lab-price__was" data-lab-was{% if i_was_f == blank %} hidden{% endif %}>{{ i_was_f | strip }}</s>
            <span class="lab-price__badge" data-lab-badge{% if i_badge == blank %} hidden{% endif %}>{{ i_badge }}</span>
          </div>
          <span class="lab-unit" data-lab-unitline{% if start_q == 1 %} hidden{% endif %}><span data-lab-unit>{{ i_unit_f | strip }}</span>{{ 'lab.card.per_unit' | t }} · <span class="lab-save" data-lab-save>{{ i_save_f | strip }}</span></span>
          {%- if first_code != blank -%}
            <p class="lab-first" data-lab-first{% unless i_first %} hidden{% endunless %}>{{ 'lab.pdp.first_note_html' | t: pct: first_pct, code: first_code }}</p>
          {%- endif -%}
          {%- if settings.lab_disc_3 > 0 and v.available -%}
            {%- capture u3 -%}{% render 'lab-pack-price', price: v.price, qty: 3, show: 'unit' %}{%- endcapture -%}
            <button type="button" class="lab-teaser" data-lab-pick="3"{% if start_q != 1 %} hidden{% endif %}>{{ 'lab.pdp.teaser' | t: unit: u3 }}</button>
          {%- endif -%}
          <p class="lab-note">{{ 'lab.pdp.tax_note' | t }}{% if section.settings.ship_note != blank %} {{ section.settings.ship_note | escape }}{% endif %}</p>
        </div>

        {%- if v.available -%}
          <p class="lab-stock">{% if tracked and v.inventory_quantity <= section.settings.low_stock %}{{ 'lab.pdp.low_stock' | t: count: v.inventory_quantity }}{% else %}{{ 'lab.pdp.in_stock' | t }}{% endif %}</p>
        {%- else -%}
          <p class="lab-stock is-out">{{ 'lab.card.sold_out' | t }}</p>
        {%- endif -%}

        <fieldset class="lab-pills">
          <legend>{{ 'lab.pdp.choose' | t }}</legend>
          {{ pills_html }}
        </fieldset>

        <div class="lab-pdp__actions" data-lab-actions>
          {%- if v.available -%}
            <a class="lab-btn lab-btn--accent lab-btn--block lab-btn--xl" data-lab-buy data-variant="{{ v.id }}" data-qty="{{ start_q }}" href="{{ i_buy }}"><span>{{ 'lab.pdp.buy_now' | t }}</span><span aria-hidden="true">·</span><span class="lab-roll" data-lab-now data-cents="{{ i_pay }}">{{ i_pay_f | strip }}</span></a>
            {%- if section.settings.cod -%}
              {%- if fee > 0 -%}
                <button type="button" class="lab-btn lab-btn--ghost lab-btn--block" data-lab-cod-open aria-expanded="false" aria-controls="{{ pid }}-cod">{% render 'lab-icon', name: 'cash' %}{{ 'lab.pdp.cod_open' | t: fee: fee_f }}</button>
              {%- else -%}
                <a class="lab-btn lab-btn--ghost lab-btn--block" data-lab-cod-go data-variant="{{ v.id }}" data-qty="{{ start_q }}" href="{{ i_cod_url }}">{% render 'lab-icon', name: 'cash' %}{{ 'lab.pdp.cod_btn' | t }}</a>
              {%- endif -%}
            {%- endif -%}
            {%- liquid
              assign pay_note = section.settings.pay_note
              if section.settings.cod and fee > 0
                assign pay_note = section.settings.pay_note_fee
              elsif section.settings.cod == false
                assign pay_note = section.settings.pay_note_nocod
              endif
            -%}
            {%- if pay_note != blank -%}<p class="lab-paynote">{% render 'lab-fill', text: pay_note, product: p %}</p>{%- endif -%}
          {%- endif -%}
          {%- assign fid = pid | append: '-form' -%}
          {%- capture add_lbl -%}{{ 'lab.pdp.add_link' | t }}{%- endcapture -%}
          {% render 'lab-atc', product: p, variant: v, qty: start_q, form_id: fid, label: add_lbl, btn: 'lab-btn--text', qty_input: true %}
        </div>

        {%- if fee > 0 and v.available -%}
          <div class="lab-cod" id="{{ pid }}-cod" data-lab-cod hidden>
            <div class="lab-cod__row"><span>{{ 'lab.pdp.cod_pack' | t }}</span><span data-lab-cod-sub>{{ i_pay_f | strip }}</span></div>
            <div class="lab-cod__row"><span>{{ 'lab.pdp.cod_fee' | t }}</span><span>{{ fee_f | strip }}</span></div>
            <div class="lab-cod__row"><strong>{{ 'lab.pdp.cod_total' | t }}</strong><strong class="lab-roll" data-lab-cod-total data-cents="{{ i_cod_c }}">{{ i_cod_f | strip }}</strong></div>
            <p>{{ 'lab.pdp.cod_help' | t }}</p>
            <a class="lab-btn lab-btn--primary lab-btn--block" data-lab-cod-go data-variant="{{ v.id }}" data-qty="{{ start_q }}" href="{{ i_cod_url }}">{{ 'lab.pdp.cod_go' | t }}{% render 'lab-icon', name: 'arrow' %}</a>
          </div>
        {%- endif -%}

        <ul class="lab-assure" role="list">
          <li>
            {% render 'lab-icon', name: 'truck' %}
            <span><strong>{% render 'lab-eta' %}</strong>{% if section.settings.g_ship != blank %}<small>{{ section.settings.g_ship | escape }}</small>{% endif %}</span>
          </li>
          {%- if section.settings.g_ret != blank -%}
            <li>
              {% render 'lab-icon', name: 'refresh' %}
              <span><strong>{{ section.settings.g_ret | escape }}</strong><small>{{ section.settings.g_ret_sub | escape }}{% if ret_page != blank %} <a href="{{ ret_page.url }}">{{ 'lab.pdp.terms' | t }}</a>{% endif %}</small></span>
            </li>
          {%- endif -%}
          {%- if section.settings.g_war != blank -%}
            <li>
              {% render 'lab-icon', name: 'shield' %}
              <span><strong>{{ section.settings.g_war | escape }}</strong>{% if section.settings.g_war_sub != blank %}<small>{{ section.settings.g_war_sub | escape }}</small>{% endif %}</span>
            </li>
          {%- endif -%}
          {%- if section.settings.g_help != blank -%}
            <li>
              {% render 'lab-icon', name: 'chat' %}
              <span><strong>{{ section.settings.g_help | escape }}</strong>
                <small>
                  {%- if section.settings.g_help_sub != blank -%}{{ section.settings.g_help_sub | escape }} {% endif -%}
                  {%- if wa != blank -%}<a href="https://wa.me/{{ wa }}" target="_blank" rel="noopener" data-lab-wa>{{ 'lab.pdp.whatsapp' | t }}</a>{% if help_page != blank %} · {% endif %}{%- endif -%}
                  {%- if help_page != blank -%}<a href="{{ help_page.url }}">{{ 'lab.pdp.write_us' | t }}</a>{%- endif -%}
                </small>
              </span>
            </li>
          {%- endif -%}
        </ul>

        {%- if shop.enabled_payment_types.size > 0 -%}
          <ul class="lab-pay" aria-label="{{ 'lab.footer.pay' | t }}">
            {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag }}</li>{%- endfor -%}
            {%- if section.settings.cod -%}<li class="lab-pay__cod">{% render 'lab-icon', name: 'cash' %}{{ 'lab.pdp.cod_chip' | t }}</li>{%- endif -%}
          </ul>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <div class="lab-acc">
            {%- for b in section.blocks -%}
              {%- case b.type -%}
                {%- when '@app' -%}
                  {% render b %}
                {%- when 'description' -%}
                  {%- if p.description != blank -%}
                    <details {{ b.shopify_attributes }}{% if b.settings.open %} open{% endif %}>
                      <summary>{{ b.settings.title | escape }}{% render 'lab-icon', name: 'plus' %}</summary>
                      <div class="lab-acc__c">{{ p.description }}</div>
                    </details>
                  {%- endif -%}
                {%- else -%}
                  <details {{ b.shopify_attributes }}{% if b.settings.open %} open{% endif %}>
                    <summary>{{ b.settings.title | escape }}{% render 'lab-icon', name: 'plus' %}</summary>
                    <div class="lab-acc__c">{% render 'lab-fill', text: b.settings.text, product: p %}</div>
                  </details>
              {%- endcase -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{%- if v.available -%}
  <div class="lab lab-sticky" data-lab-sticky="{{ pid }}" inert>
    <div class="lab-sticky__txt"><span data-lab-sticky-label>{{ i_label }}</span><strong class="lab-roll" data-lab-now data-cents="{{ i_pay }}">{{ i_pay_f | strip }}</strong></div>
    <a class="lab-btn lab-btn--accent" data-lab-buy data-lab-place="barra" data-variant="{{ v.id }}" data-qty="{{ start_q }}" href="{{ i_buy }}">{{ 'lab.pdp.buy_now' | t }}</a>
  </div>
{%- endif -%}


{% schema %}
{ "name": "Sonda", "settings": [] }
{% endschema %}
