<div></div>
{% schema %}
{
  "name": "Sonda i6",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Ceja",
      "default": "Aparato de bienestar · uso doméstico"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtítulo del H1 (opcional)",
      "info": "Vacío, el precio sube en la primera pantalla del móvil."
    },
    {
      "type": "text",
      "id": "brand",
      "label": "Marca (datos estructurados)",
      "default": "ReliefPath"
    },
    {
      "type": "text",
      "id": "ship_note",
      "label": "Nota bajo el precio",
      "default": "Envío gratis."
    },
    {
      "type": "range",
      "id": "default_pack",
      "label": "Pack elegido al entrar",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "low_stock",
      "label": "Avisar de pocas unidades por debajo de",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 10
    },
    {
      "type": "text",
      "id": "s1",
      "label": "1 unidad · texto",
      "default": "Un aparato"
    },
    {
      "type": "text",
      "id": "s2",
      "label": "Pack de 2 · texto",
      "default": "Uno para ti y otro para regalar"
    },
    {
      "type": "text",
      "id": "s3",
      "label": "Pack de 3 · texto",
      "default": "El precio más bajo por unidad"
    },
    {
      "type": "header",
      "content": "Botones y pago"
    },
    {
      "type": "checkbox",
      "id": "cod",
      "label": "Botón «Pagar al recibirlo»",
      "info": "El recargo, si lo cobras, se activa en Ajustes del tema › ReliefPath Lab.",
      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "pay_note",
      "label": "Nota bajo los botones",
      "default": "Pagar al recibirlo no tiene recargo. También con tarjeta, Bizum, PayPal o Klarna: lo eliges en el último paso."
    },
    {
      "type": "inline_richtext",
      "id": "pay_note_fee",
      "label": "Nota bajo los botones (con recargo)",
      "info": "[fee] escribe el importe del recargo.",
      "default": "Con tarjeta, Bizum, PayPal o Klarna no hay recargo. Al recibirlo se añaden [fee] de gestión."
    },
    {
      "type": "inline_richtext",
      "id": "pay_note_nocod",
      "label": "Nota bajo los botones (sin contrareembolso)",
      "default": "Pago seguro con tarjeta, Bizum, PayPal o Klarna."
    },
    {
      "type": "header",
      "content": "Garantías junto al botón"
    },
    {
      "type": "text",
      "id": "g_ship",
      "label": "Entrega · detalle",
      "info": "La fecha se calcula sola (Ajustes del tema › Entrega estimada).",
      "default": "Envío gratis desde España. Estimación para península."
    },
    {
      "type": "text",
      "id": "g_ret",
      "label": "Devolución",
      "default": "30 días para devolverlo"
    },
    {
      "type": "text",
      "id": "g_ret_sub",
      "label": "Devolución · detalle",
      "default": "La etiqueta de vuelta la pagamos nosotros."
    },
    {
      "type": "page",
      "id": "ret_page",
      "label": "Devolución · página",
      "info": "Vacío: la página «devoluciones»."
    },
    {
      "type": "text",
      "id": "g_war",
      "label": "Garantía",
      "default": "3 años de garantía legal"
    },
    {
      "type": "text",
      "id": "g_war_sub",
      "label": "Garantía · detalle",
      "default": "Si falla, se repara o se cambia."
    },
    {
      "type": "text",
      "id": "g_help",
      "label": "Ayuda",
      "default": "¿Dudas antes de comprar?"
    },
    {
      "type": "text",
      "id": "g_help_sub",
      "label": "Ayuda · detalle",
      "default": "Te respondemos en español."
    },
    {
      "type": "page",
      "id": "help_page",
      "label": "Ayuda · página",
      "info": "Vacío: la página «contact». El WhatsApp se pone en Ajustes del tema."
    },
    {
      "type": "header",
      "content": "Datos estructurados"
    },
    {
      "type": "checkbox",
      "id": "free_shipping",
      "label": "Envío gratis a España",
      "info": "Solo si el envío es gratis de verdad en el checkout.",
      "default": true
    },
    {
      "type": "number",
      "id": "return_days",
      "label": "Días para devolver",
      "info": "0 para no publicarlo.",
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "tab",
      "name": "Pestaña",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Modo de uso"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Texto",
          "info": "Admite las marcas [p1] [p2] [p3] [u2] [u3] [cod] [fee].",
          "default": "<p>Escribe aquí el contenido.</p>"
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "Abierto",
          "default": false
        }
      ]
    }
  ]
}
{% endschema %}
