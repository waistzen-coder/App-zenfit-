{%- comment -%} Estilos comunes de las secciones sr-* (incluyen las fuentes, servidas desde el tema). Cada sección lo llama; el navegador solo los descarga una vez. {%- endcomment -%}
{{ 'sr.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  En las plantillas JSON el contenedor de cada sección se llama
  «shopify-section-template--123__contrareembolso», no «shopify-section-contrareembolso».
  Este guardián hace que los enlaces cortos (#shopify-section-contrareembolso) encuentren
  su sección igualmente, incluidos los de la barra fija y el cierre.
{%- endcomment -%}
<script>
if(!window.__srAnchors){window.__srAnchors=1;
  /* Medición: eventos propios «reliefpath:*» con la API de eventos de cliente de
     Shopify. Llegan a los píxeles de la tienda (Ajustes → Eventos de cliente) y
     Shopify aplica el consentimiento de cookies. No se lanzan eventos estándar
     (InitiateCheckout, AddPaymentInfo…): esos los envía ya el checkout de Shopify
     y repetirlos aquí los contaría dos veces. */
  window.srTrack=function(name,data){ data=data||{};
    try{ if(window.Shopify&&Shopify.analytics&&Shopify.analytics.publish){ var r=Shopify.analytics.publish('reliefpath:'+name,data); if(r&&r.catch) r.catch(function(){}); } }catch(e){}
    try{ if(window.dataLayer){ var o={event:'reliefpath_'+name}; for(var k in data) o[k]=data[k]; window.dataLayer.push(o); } }catch(e){}
  };
  var srFind=function(h){ if(!h||h.charAt(0)!=='#'||h.length<2) return null; var id=decodeURIComponent(h.slice(1)), t=document.getElementById(id);
    if(!t && id.indexOf('shopify-section-')===0){ t=document.querySelector('[id$="__'+id.slice(16)+'"]'); } return t; };
  document.addEventListener('click',function(e){ var a=e.target.closest&&e.target.closest('a[href^="#"]'); if(!a) return;
    var t=srFind(a.getAttribute('href')); if(!t) return; e.preventDefault(); t.scrollIntoView({behavior:'smooth',block:'start'}); });
  window.addEventListener('load',function(){ var t=srFind(location.hash); if(t) t.scrollIntoView(); });
  /* Aparición suave de las secciones al entrar en pantalla. Sin
     IntersectionObserver o con movimiento reducido no se oculta nada. */
  if('IntersectionObserver' in window && !(window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches) && !(window.Shopify && Shopify.designMode)){
    document.documentElement.classList.add('sr-js');
    var srRan=false;
    var srIO=new IntersectionObserver(function(es){ srRan=true; es.forEach(function(en){ if(en.isIntersecting){ en.target.classList.add('is-in'); srIO.unobserve(en.target); } }); },{rootMargin:'0px 0px -8% 0px'});
    var srWatch=function(){ document.querySelectorAll('.sr-sec:not(.is-in)').forEach(function(el){ srIO.observe(el); }); };
    if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',srWatch); else srWatch();
    /* Red de seguridad: si el observador no llega a funcionar, se enseña todo. */
    setTimeout(function(){ if(!srRan) document.querySelectorAll('.sr-sec').forEach(function(el){ el.classList.add('is-in'); }); },3000);
  }
}
</script>
