{
 "frases": [
  {
   "n": 1,
   "texto": "Mito: si levantas pesas, te pones enorme.",
   "inicio": 0.12,
   "fin": 2.55
  },
  {
   "n": 2,
   "texto": "Marta llevaba dos años solo en la cinta.",
   "inicio": 2.79,
   "fin": 5.19
  },
  {
   "n": 3,
   "texto": "Le daban miedo las pesas.",
   "inicio": 5.43,
   "fin": 7.03
  },
  {
   "n": 4,
   "texto": "Se imaginaba así.",
   "inicio": 7.27,
   "fin": 8.55
  },
  {
   "n": 5,
   "texto": "Hasta que se lo preguntó al dependiente.",
   "inicio": 8.79,
   "fin": 11.09
  },
  {
   "n": 6,
   "texto": "Ganar músculo cuesta años, no semanas.",
   "inicio": 11.33,
   "fin": 13.76
  },
  {
   "n": 7,
   "texto": "Y las mujeres tienen mucha menos testosterona.",
   "inicio": 14.0,
   "fin": 16.73
  },
  {
   "n": 8,
   "texto": "Lo que te dan las pesas es fuerza.",
   "inicio": 16.97,
   "fin": 19.05
  },
  {
   "n": 9,
   "texto": "Y si con la comida no llegas a la proteína, te ayudamos a elegir.",
   "inicio": 19.29,
   "fin": 22.91
  },
  {
   "n": 10,
   "texto": "Marta cogió la barra.",
   "inicio": 23.15,
   "fin": 24.55
  },
  {
   "n": 11,
   "texto": "Ocho semanas después sigue siendo Marta.",
   "inicio": 24.79,
   "fin": 27.38
  },
  {
   "n": 12,
   "texto": "Pero levanta el doble.",
   "inicio": 27.62,
   "fin": 29.06
  },
  {
   "n": 13,
   "texto": "Veredicto: mito.",
   "inicio": 29.56,
   "fin": 30.766
  },
  {
   "n": 14,
   "texto": "¿Qué mito desmontamos en el siguiente? Déjalo en los comentarios.",
   "inicio": 31.266,
   "fin": 34.826
  },
  {
   "n": 15,
   "texto": "Y síguenos para no perdértelo.",
   "inicio": 35.066,
   "fin": 36.886
  }
 ],
 "duracion": 37.436
}